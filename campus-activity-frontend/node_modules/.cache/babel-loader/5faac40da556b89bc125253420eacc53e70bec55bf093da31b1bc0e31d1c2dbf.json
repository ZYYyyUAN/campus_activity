{"ast":null,"code":"import { signScoreApi } from '@/api';\nexport default {\n  name: 'MySignScore',\n  data() {\n    return {\n      signScoreList: [],\n      totalScore: 0,\n      loading: false\n    };\n  },\n  mounted() {\n    this.loadSignScoreList();\n    this.loadTotalScore();\n  },\n  methods: {\n    async loadSignScoreList() {\n      this.loading = true;\n      try {\n        const userId = this.$store.state.user.userId;\n        const res = await signScoreApi.getSignList(userId);\n        if (res.code === 200) {\n          this.signScoreList = res.data || [];\n        }\n      } catch (error) {\n        console.error('加载签到列表失败:', error);\n      } finally {\n        this.loading = false;\n      }\n    },\n    async loadTotalScore() {\n      try {\n        const userId = this.$store.state.user.userId;\n        const res = await signScoreApi.getTotalScore(userId);\n        if (res.code === 200) {\n          this.totalScore = res.data || 0;\n        }\n      } catch (error) {\n        console.error('加载总积分失败:', error);\n      }\n    },\n    formatDateTime(dateStr) {\n      if (!dateStr) return '';\n      const date = new Date(dateStr);\n      return date.toLocaleString('zh-CN');\n    }\n  }\n};","map":{"version":3,"names":["signScoreApi","name","data","signScoreList","totalScore","loading","mounted","loadSignScoreList","loadTotalScore","methods","userId","$store","state","user","res","getSignList","code","error","console","getTotalScore","formatDateTime","dateStr","date","Date","toLocaleString"],"sources":["src/views/student/MySignScore.vue"],"sourcesContent":["<template>\r\n  <div class=\"my-sign-score\">\r\n    <el-card>\r\n      <div slot=\"header\">\r\n        <span>我的签到与积分</span>\r\n      </div>\r\n      \r\n      <div class=\"score-summary\">\r\n        <el-card class=\"summary-card\">\r\n          <div class=\"summary-content\">\r\n            <div class=\"summary-label\">总积分</div>\r\n            <div class=\"summary-value\">{{ totalScore }}</div>\r\n          </div>\r\n        </el-card>\r\n      </div>\r\n      \r\n      <el-table :data=\"signScoreList\" border style=\"width: 100%\" v-loading=\"loading\">\r\n        <el-table-column prop=\"activityName\" label=\"活动名称\" min-width=\"150\"></el-table-column>\r\n        <el-table-column prop=\"signTime\" label=\"签到时间\" width=\"180\">\r\n          <template slot-scope=\"scope\">\r\n            {{ formatDateTime(scope.row.signTime) }}\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column prop=\"score\" label=\"获得积分\" width=\"120\">\r\n          <template slot-scope=\"scope\">\r\n            <el-tag type=\"success\">+{{ scope.row.score }}</el-tag>\r\n          </template>\r\n        </el-table-column>\r\n      </el-table>\r\n    </el-card>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { signScoreApi } from '@/api'\r\n\r\nexport default {\r\n  name: 'MySignScore',\r\n  data() {\r\n    return {\r\n      signScoreList: [],\r\n      totalScore: 0,\r\n      loading: false\r\n    }\r\n  },\r\n  mounted() {\r\n    this.loadSignScoreList()\r\n    this.loadTotalScore()\r\n  },\r\n  methods: {\r\n    async loadSignScoreList() {\r\n      this.loading = true\r\n      try {\r\n        const userId = this.$store.state.user.userId\r\n        const res = await signScoreApi.getSignList(userId)\r\n        if (res.code === 200) {\r\n          this.signScoreList = res.data || []\r\n        }\r\n      } catch (error) {\r\n        console.error('加载签到列表失败:', error)\r\n      } finally {\r\n        this.loading = false\r\n      }\r\n    },\r\n    async loadTotalScore() {\r\n      try {\r\n        const userId = this.$store.state.user.userId\r\n        const res = await signScoreApi.getTotalScore(userId)\r\n        if (res.code === 200) {\r\n          this.totalScore = res.data || 0\r\n        }\r\n      } catch (error) {\r\n        console.error('加载总积分失败:', error)\r\n      }\r\n    },\r\n    formatDateTime(dateStr) {\r\n      if (!dateStr) return ''\r\n      const date = new Date(dateStr)\r\n      return date.toLocaleString('zh-CN')\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.my-sign-score {\r\n  padding: 20px;\r\n}\r\n\r\n.score-summary {\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.summary-card {\r\n  max-width: 300px;\r\n}\r\n\r\n.summary-content {\r\n  text-align: center;\r\n}\r\n\r\n.summary-label {\r\n  font-size: 14px;\r\n  color: #909399;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.summary-value {\r\n  font-size: 36px;\r\n  font-weight: bold;\r\n  color: #409EFF;\r\n}\r\n</style>\r\n"],"mappings":"AAkCA,SAAAA,YAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,aAAA;MACAC,UAAA;MACAC,OAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,iBAAA;IACA,KAAAC,cAAA;EACA;EACAC,OAAA;IACA,MAAAF,kBAAA;MACA,KAAAF,OAAA;MACA;QACA,MAAAK,MAAA,QAAAC,MAAA,CAAAC,KAAA,CAAAC,IAAA,CAAAH,MAAA;QACA,MAAAI,GAAA,SAAAd,YAAA,CAAAe,WAAA,CAAAL,MAAA;QACA,IAAAI,GAAA,CAAAE,IAAA;UACA,KAAAb,aAAA,GAAAW,GAAA,CAAAZ,IAAA;QACA;MACA,SAAAe,KAAA;QACAC,OAAA,CAAAD,KAAA,cAAAA,KAAA;MACA;QACA,KAAAZ,OAAA;MACA;IACA;IACA,MAAAG,eAAA;MACA;QACA,MAAAE,MAAA,QAAAC,MAAA,CAAAC,KAAA,CAAAC,IAAA,CAAAH,MAAA;QACA,MAAAI,GAAA,SAAAd,YAAA,CAAAmB,aAAA,CAAAT,MAAA;QACA,IAAAI,GAAA,CAAAE,IAAA;UACA,KAAAZ,UAAA,GAAAU,GAAA,CAAAZ,IAAA;QACA;MACA,SAAAe,KAAA;QACAC,OAAA,CAAAD,KAAA,aAAAA,KAAA;MACA;IACA;IACAG,eAAAC,OAAA;MACA,KAAAA,OAAA;MACA,MAAAC,IAAA,OAAAC,IAAA,CAAAF,OAAA;MACA,OAAAC,IAAA,CAAAE,cAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}