{"ast":null,"code":"export default {\n  name: 'MainLayout',\n  computed: {\n    user() {\n      return this.$store.state.user || {};\n    },\n    isAdmin() {\n      return this.$store.getters.isAdmin;\n    },\n    isPublisher() {\n      return this.$store.getters.isPublisher;\n    },\n    isStudent() {\n      return this.$store.getters.isStudent;\n    },\n    activeMenu() {\n      return this.$route.path;\n    }\n  },\n  methods: {\n    handleCommand(command) {\n      if (command === 'logout') {\n        this.$confirm('确定要退出登录吗?', '提示', {\n          confirmButtonText: '确定',\n          cancelButtonText: '取消',\n          type: 'warning'\n        }).then(() => {\n          this.$store.dispatch('logout');\n          this.$message.success('已退出登录');\n          this.$router.push('/login');\n        });\n      }\n    }\n  }\n};","map":{"version":3,"names":["name","computed","user","$store","state","isAdmin","getters","isPublisher","isStudent","activeMenu","$route","path","methods","handleCommand","command","$confirm","confirmButtonText","cancelButtonText","type","then","dispatch","$message","success","$router","push"],"sources":["src/layout/MainLayout.vue"],"sourcesContent":["<template>\n  <el-container class=\"main-container\">\n    <el-header class=\"header\">\n      <div class=\"header-left\">\n        <h2>校园活动报名管理系统</h2>\n      </div>\n      <div class=\"header-right\">\n        <el-dropdown @command=\"handleCommand\">\n          <span class=\"user-info\">\n            <i class=\"el-icon-user\"></i>\n            {{ user.realName || user.username }}\n            <i class=\"el-icon-arrow-down el-icon--right\"></i>\n          </span>\n          <el-dropdown-menu slot=\"dropdown\">\n            <el-dropdown-item command=\"logout\">退出登录</el-dropdown-item>\n          </el-dropdown-menu>\n        </el-dropdown>\n      </div>\n    </el-header>\n    <el-container>\n      <el-aside width=\"200px\" class=\"sidebar\">\n        <el-menu\n          :default-active=\"activeMenu\"\n          router\n          background-color=\"#304156\"\n          text-color=\"#bfcbd9\"\n          active-text-color=\"#409EFF\"\n        >\n          <el-menu-item index=\"/dashboard\">\n            <i class=\"el-icon-data-line\"></i>\n            <span>首页</span>\n          </el-menu-item>\n          \n          <!-- 管理员菜单 -->\n          <template v-if=\"isAdmin\">\n            <el-menu-item index=\"/activity\">\n              <i class=\"el-icon-tickets\"></i>\n              <span>活动管理</span>\n            </el-menu-item>\n            <el-menu-item index=\"/publisher/audit\">\n              <i class=\"el-icon-check\"></i>\n              <span>报名审核</span>\n            </el-menu-item>\n            <el-menu-item index=\"/publisher/statistics\">\n              <i class=\"el-icon-data-analysis\"></i>\n              <span>参与情况</span>\n            </el-menu-item>\n            <el-menu-item index=\"/evaluation\">\n              <i class=\"el-icon-star-off\"></i>\n              <span>评价管理</span>\n            </el-menu-item>\n            <el-menu-item index=\"/user\">\n              <i class=\"el-icon-user\"></i>\n              <span>用户管理</span>\n            </el-menu-item>\n            <el-menu-item index=\"/log\">\n              <i class=\"el-icon-document\"></i>\n              <span>日志管理</span>\n            </el-menu-item>\n          </template>\n          \n          <!-- 发布者菜单 -->\n          <template v-if=\"isPublisher\">\n            <el-menu-item index=\"/activity\">\n              <i class=\"el-icon-tickets\"></i>\n              <span>活动管理</span>\n            </el-menu-item>\n            <el-menu-item index=\"/publisher/audit\">\n              <i class=\"el-icon-check\"></i>\n              <span>报名审核</span>\n            </el-menu-item>\n            <el-menu-item index=\"/publisher/statistics\">\n              <i class=\"el-icon-data-analysis\"></i>\n              <span>参与情况</span>\n            </el-menu-item>\n          </template>\n          \n          <!-- 学生菜单 -->\n          <template v-if=\"isStudent\">\n            <el-menu-item index=\"/student/browse\">\n              <i class=\"el-icon-view\"></i>\n              <span>活动浏览</span>\n            </el-menu-item>\n            <el-menu-item index=\"/student/registration\">\n              <i class=\"el-icon-edit-outline\"></i>\n              <span>我的报名</span>\n            </el-menu-item>\n            <el-menu-item index=\"/student/signscore\">\n              <i class=\"el-icon-star-on\"></i>\n              <span>我的积分</span>\n            </el-menu-item>\n          </template>\n        </el-menu>\n      </el-aside>\n      <el-main class=\"main-content\">\n        <router-view></router-view>\n      </el-main>\n    </el-container>\n  </el-container>\n</template>\n\n<script>\nexport default {\n  name: 'MainLayout',\n  computed: {\n    user() {\n      return this.$store.state.user || {}\n    },\n    isAdmin() {\n      return this.$store.getters.isAdmin\n    },\n    isPublisher() {\n      return this.$store.getters.isPublisher\n    },\n    isStudent() {\n      return this.$store.getters.isStudent\n    },\n    activeMenu() {\n      return this.$route.path\n    }\n  },\n  methods: {\n    handleCommand(command) {\n      if (command === 'logout') {\n        this.$confirm('确定要退出登录吗?', '提示', {\n          confirmButtonText: '确定',\n          cancelButtonText: '取消',\n          type: 'warning'\n        }).then(() => {\n          this.$store.dispatch('logout')\n          this.$message.success('已退出登录')\n          this.$router.push('/login')\n        })\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n.main-container {\n  height: 100vh;\n}\n\n.header {\n  background: #304156;\n  color: white;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 0 20px;\n}\n\n.header-left h2 {\n  margin: 0;\n  font-size: 20px;\n}\n\n.header-right {\n  display: flex;\n  align-items: center;\n}\n\n.user-info {\n  color: white;\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n}\n\n.sidebar {\n  background: #304156;\n}\n\n.main-content {\n  background: #f0f2f5;\n  padding: 20px;\n}\n</style>\n\n"],"mappings":"AAsGA;EACAA,IAAA;EACAC,QAAA;IACAC,KAAA;MACA,YAAAC,MAAA,CAAAC,KAAA,CAAAF,IAAA;IACA;IACAG,QAAA;MACA,YAAAF,MAAA,CAAAG,OAAA,CAAAD,OAAA;IACA;IACAE,YAAA;MACA,YAAAJ,MAAA,CAAAG,OAAA,CAAAC,WAAA;IACA;IACAC,UAAA;MACA,YAAAL,MAAA,CAAAG,OAAA,CAAAE,SAAA;IACA;IACAC,WAAA;MACA,YAAAC,MAAA,CAAAC,IAAA;IACA;EACA;EACAC,OAAA;IACAC,cAAAC,OAAA;MACA,IAAAA,OAAA;QACA,KAAAC,QAAA;UACAC,iBAAA;UACAC,gBAAA;UACAC,IAAA;QACA,GAAAC,IAAA;UACA,KAAAhB,MAAA,CAAAiB,QAAA;UACA,KAAAC,QAAA,CAAAC,OAAA;UACA,KAAAC,OAAA,CAAAC,IAAA;QACA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}