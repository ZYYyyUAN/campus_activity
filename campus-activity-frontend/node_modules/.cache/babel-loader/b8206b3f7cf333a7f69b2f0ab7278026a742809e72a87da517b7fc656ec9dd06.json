{"ast":null,"code":"import { activityApi } from '@/api';\nexport default {\n  name: 'ActivityStatistics',\n  data() {\n    return {\n      activityList: [],\n      loading: false\n    };\n  },\n  mounted() {\n    this.loadActivityList();\n  },\n  methods: {\n    async loadActivityList() {\n      this.loading = true;\n      try {\n        const publisherId = this.$store.state.user.userId;\n        const res = await activityApi.getActivityByPublisher(publisherId);\n        if (res.code === 200) {\n          this.activityList = res.data || [];\n        }\n      } catch (error) {\n        console.error('加载活动列表失败:', error);\n      } finally {\n        this.loading = false;\n      }\n    },\n    getRegistrationCount(activityId) {\n      // 这里应该调用API获取报名人数，暂时返回0\n      return 0;\n    },\n    getSignCount(activityId) {\n      // 这里应该调用API获取签到人数，暂时返回0\n      return 0;\n    },\n    handleViewDetail(row) {\n      // 查看活动详情\n      this.$router.push(`/activity/${row.activityId}`);\n    },\n    formatDateTime(dateStr) {\n      if (!dateStr) return '';\n      const date = new Date(dateStr);\n      return date.toLocaleString('zh-CN');\n    }\n  }\n};","map":{"version":3,"names":["activityApi","name","data","activityList","loading","mounted","loadActivityList","methods","publisherId","$store","state","user","userId","res","getActivityByPublisher","code","error","console","getRegistrationCount","activityId","getSignCount","handleViewDetail","row","$router","push","formatDateTime","dateStr","date","Date","toLocaleString"],"sources":["src/views/publisher/ActivityStatistics.vue"],"sourcesContent":["<template>\r\n  <div class=\"activity-statistics\">\r\n    <el-card>\r\n      <div slot=\"header\">\r\n        <span>活动参与情况</span>\r\n      </div>\r\n      \r\n      <el-table :data=\"activityList\" border style=\"width: 100%\" v-loading=\"loading\">\r\n        <el-table-column prop=\"activityName\" label=\"活动名称\" min-width=\"150\"></el-table-column>\r\n        <el-table-column prop=\"activityType\" label=\"活动类型\" width=\"120\"></el-table-column>\r\n        <el-table-column prop=\"startTime\" label=\"开始时间\" width=\"180\">\r\n          <template slot-scope=\"scope\">\r\n            {{ formatDateTime(scope.row.startTime) }}\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column prop=\"maxPeople\" label=\"人数上限\" width=\"100\"></el-table-column>\r\n        <el-table-column label=\"报名人数\" width=\"120\">\r\n          <template slot-scope=\"scope\">\r\n            {{ getRegistrationCount(scope.row.activityId) }}\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column label=\"签到人数\" width=\"120\">\r\n          <template slot-scope=\"scope\">\r\n            {{ getSignCount(scope.row.activityId) }}\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column label=\"操作\" width=\"150\">\r\n          <template slot-scope=\"scope\">\r\n            <el-button size=\"mini\" @click=\"handleViewDetail(scope.row)\">查看详情</el-button>\r\n          </template>\r\n        </el-table-column>\r\n      </el-table>\r\n    </el-card>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { activityApi } from '@/api'\r\n\r\nexport default {\r\n  name: 'ActivityStatistics',\r\n  data() {\r\n    return {\r\n      activityList: [],\r\n      loading: false\r\n    }\r\n  },\r\n  mounted() {\r\n    this.loadActivityList()\r\n  },\r\n  methods: {\r\n    async loadActivityList() {\r\n      this.loading = true\r\n      try {\r\n        const publisherId = this.$store.state.user.userId\r\n        const res = await activityApi.getActivityByPublisher(publisherId)\r\n        if (res.code === 200) {\r\n          this.activityList = res.data || []\r\n        }\r\n      } catch (error) {\r\n        console.error('加载活动列表失败:', error)\r\n      } finally {\r\n        this.loading = false\r\n      }\r\n    },\r\n    getRegistrationCount(activityId) {\r\n      // 这里应该调用API获取报名人数，暂时返回0\r\n      return 0\r\n    },\r\n    getSignCount(activityId) {\r\n      // 这里应该调用API获取签到人数，暂时返回0\r\n      return 0\r\n    },\r\n    handleViewDetail(row) {\r\n      // 查看活动详情\r\n      this.$router.push(`/activity/${row.activityId}`)\r\n    },\r\n    formatDateTime(dateStr) {\r\n      if (!dateStr) return ''\r\n      const date = new Date(dateStr)\r\n      return date.toLocaleString('zh-CN')\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.activity-statistics {\r\n  padding: 20px;\r\n}\r\n</style>\r\n"],"mappings":"AAqCA,SAAAA,WAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,YAAA;MACAC,OAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,gBAAA;EACA;EACAC,OAAA;IACA,MAAAD,iBAAA;MACA,KAAAF,OAAA;MACA;QACA,MAAAI,WAAA,QAAAC,MAAA,CAAAC,KAAA,CAAAC,IAAA,CAAAC,MAAA;QACA,MAAAC,GAAA,SAAAb,WAAA,CAAAc,sBAAA,CAAAN,WAAA;QACA,IAAAK,GAAA,CAAAE,IAAA;UACA,KAAAZ,YAAA,GAAAU,GAAA,CAAAX,IAAA;QACA;MACA,SAAAc,KAAA;QACAC,OAAA,CAAAD,KAAA,cAAAA,KAAA;MACA;QACA,KAAAZ,OAAA;MACA;IACA;IACAc,qBAAAC,UAAA;MACA;MACA;IACA;IACAC,aAAAD,UAAA;MACA;MACA;IACA;IACAE,iBAAAC,GAAA;MACA;MACA,KAAAC,OAAA,CAAAC,IAAA,cAAAF,GAAA,CAAAH,UAAA;IACA;IACAM,eAAAC,OAAA;MACA,KAAAA,OAAA;MACA,MAAAC,IAAA,OAAAC,IAAA,CAAAF,OAAA;MACA,OAAAC,IAAA,CAAAE,cAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}