{"ast":null,"code":"import { activityApi, registrationApi } from '@/api';\nexport default {\n  name: 'ActivityBrowse',\n  data() {\n    return {\n      activityList: [],\n      loading: false,\n      searchForm: {\n        activityType: '',\n        keyword: ''\n      }\n    };\n  },\n  mounted() {\n    this.loadActivityList();\n  },\n  methods: {\n    async loadActivityList() {\n      this.loading = true;\n      try {\n        const res = await activityApi.getActivityList();\n        if (res.code === 200) {\n          this.activityList = res.data || [];\n        }\n      } catch (error) {\n        console.error('加载活动列表失败:', error);\n      } finally {\n        this.loading = false;\n      }\n    },\n    async handleRegister(row) {\n      try {\n        const res = await registrationApi.registerActivity({\n          activityId: row.activityId,\n          userId: this.$store.state.user.userId\n        });\n        if (res.code === 200) {\n          this.$message.success('报名成功！请到\"我的报名\"页面查看');\n          this.loadActivityList();\n        }\n      } catch (error) {\n        console.error('报名失败:', error);\n      }\n    },\n    handleSearch() {\n      this.loadActivityList();\n    },\n    handleReset() {\n      this.searchForm = {\n        activityType: '',\n        keyword: ''\n      };\n      this.loadActivityList();\n    },\n    formatDateTime(dateStr) {\n      if (!dateStr) return '';\n      const date = new Date(dateStr);\n      return date.toLocaleString('zh-CN');\n    }\n  }\n};","map":{"version":3,"names":["activityApi","registrationApi","name","data","activityList","loading","searchForm","activityType","keyword","mounted","loadActivityList","methods","res","getActivityList","code","error","console","handleRegister","row","registerActivity","activityId","userId","$store","state","user","$message","success","handleSearch","handleReset","formatDateTime","dateStr","date","Date","toLocaleString"],"sources":["src/views/student/ActivityBrowse.vue"],"sourcesContent":["<template>\n  <div class=\"activity-browse\">\n    <el-card>\n      <div slot=\"header\">\n        <span>活动浏览</span>\n      </div>\n      \n      <!-- 搜索栏 -->\n      <el-form :inline=\"true\" :model=\"searchForm\" class=\"search-form\">\n        <el-form-item label=\"活动类型\">\n          <el-select v-model=\"searchForm.activityType\" placeholder=\"请选择\" clearable>\n            <el-option label=\"讲座\" value=\"讲座\"></el-option>\n            <el-option label=\"比赛\" value=\"比赛\"></el-option>\n            <el-option label=\"学术论坛\" value=\"学术论坛\"></el-option>\n            <el-option label=\"班级活动\" value=\"班级活动\"></el-option>\n            <el-option label=\"志愿服务\" value=\"志愿服务\"></el-option>\n          </el-select>\n        </el-form-item>\n        <el-form-item label=\"时间范围\">\n          <el-date-picker\n            v-model=\"searchForm.timeRange\"\n            type=\"datetimerange\"\n            range-separator=\"至\"\n            start-placeholder=\"开始时间\"\n            end-placeholder=\"结束时间\"\n            value-format=\"yyyy-MM-dd HH:mm:ss\">\n          </el-date-picker>\n        </el-form-item>\n        <el-form-item label=\"关键词\">\n          <el-input v-model=\"searchForm.keyword\" placeholder=\"活动名称/地点\" clearable></el-input>\n        </el-form-item>\n        <el-form-item>\n          <el-button type=\"primary\" icon=\"el-icon-search\" @click=\"handleSearch\">查询</el-button>\n          <el-button icon=\"el-icon-refresh\" @click=\"handleReset\">重置</el-button>\n        </el-form-item>\n      </el-form>\n      \n      <!-- 活动表格 -->\n      <el-table :data=\"activityList\" border style=\"width: 100%\" v-loading=\"loading\">\n        <el-table-column prop=\"activityName\" label=\"活动名称\" min-width=\"150\"></el-table-column>\n        <el-table-column prop=\"activityType\" label=\"活动类型\" width=\"120\"></el-table-column>\n        <el-table-column prop=\"location\" label=\"活动地点\" width=\"150\"></el-table-column>\n        <el-table-column prop=\"publisherName\" label=\"发布者\" width=\"120\"></el-table-column>\n        <el-table-column prop=\"startTime\" label=\"开始时间\" width=\"180\" sortable>\n          <template slot-scope=\"scope\">\n            {{ formatDateTime(scope.row.startTime) }}\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"maxPeople\" label=\"人数上限\" width=\"100\"></el-table-column>\n        <el-table-column prop=\"status\" label=\"状态\" width=\"100\">\n          <template slot-scope=\"scope\">\n            <el-tag :type=\"scope.row.status === '报名中' ? 'success' : 'info'\">\n              {{ scope.row.status }}\n            </el-tag>\n          </template>\n        </el-table-column>\n        <el-table-column label=\"操作\" width=\"120\" fixed=\"right\">\n          <template slot-scope=\"scope\">\n            <el-button size=\"mini\" type=\"primary\" @click=\"handleRegister(scope.row)\">报名</el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n    </el-card>\n  </div>\n</template>\n\n<script>\nimport { activityApi, registrationApi } from '@/api'\n\nexport default {\n  name: 'ActivityBrowse',\n  data() {\n    return {\n      activityList: [],\n      loading: false,\n      searchForm: {\n        activityType: '',\n        keyword: ''\n      }\n    }\n  },\n  mounted() {\n    this.loadActivityList()\n  },\n  methods: {\n    async loadActivityList() {\n      this.loading = true\n      try {\n        const res = await activityApi.getActivityList()\n        if (res.code === 200) {\n          this.activityList = res.data || []\n        }\n      } catch (error) {\n        console.error('加载活动列表失败:', error)\n      } finally {\n        this.loading = false\n      }\n    },\n    async handleRegister(row) {\n      try {\n        const res = await registrationApi.registerActivity({\n          activityId: row.activityId,\n          userId: this.$store.state.user.userId\n        })\n        if (res.code === 200) {\n          this.$message.success('报名成功！请到\"我的报名\"页面查看')\n          this.loadActivityList()\n        }\n      } catch (error) {\n        console.error('报名失败:', error)\n      }\n    },\n    handleSearch() {\n      this.loadActivityList()\n    },\n    handleReset() {\n      this.searchForm = {\n        activityType: '',\n        keyword: ''\n      }\n      this.loadActivityList()\n    },\n    formatDateTime(dateStr) {\n      if (!dateStr) return ''\n      const date = new Date(dateStr)\n      return date.toLocaleString('zh-CN')\n    }\n  }\n}\n</script>\n\n<style scoped>\n.activity-browse {\n  padding: 20px;\n}\n\n.search-form {\n  margin-bottom: 20px;\n}\n</style>\n"],"mappings":"AAmEA,SAAAA,WAAA,EAAAC,eAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,YAAA;MACAC,OAAA;MACAC,UAAA;QACAC,YAAA;QACAC,OAAA;MACA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,gBAAA;EACA;EACAC,OAAA;IACA,MAAAD,iBAAA;MACA,KAAAL,OAAA;MACA;QACA,MAAAO,GAAA,SAAAZ,WAAA,CAAAa,eAAA;QACA,IAAAD,GAAA,CAAAE,IAAA;UACA,KAAAV,YAAA,GAAAQ,GAAA,CAAAT,IAAA;QACA;MACA,SAAAY,KAAA;QACAC,OAAA,CAAAD,KAAA,cAAAA,KAAA;MACA;QACA,KAAAV,OAAA;MACA;IACA;IACA,MAAAY,eAAAC,GAAA;MACA;QACA,MAAAN,GAAA,SAAAX,eAAA,CAAAkB,gBAAA;UACAC,UAAA,EAAAF,GAAA,CAAAE,UAAA;UACAC,MAAA,OAAAC,MAAA,CAAAC,KAAA,CAAAC,IAAA,CAAAH;QACA;QACA,IAAAT,GAAA,CAAAE,IAAA;UACA,KAAAW,QAAA,CAAAC,OAAA;UACA,KAAAhB,gBAAA;QACA;MACA,SAAAK,KAAA;QACAC,OAAA,CAAAD,KAAA,UAAAA,KAAA;MACA;IACA;IACAY,aAAA;MACA,KAAAjB,gBAAA;IACA;IACAkB,YAAA;MACA,KAAAtB,UAAA;QACAC,YAAA;QACAC,OAAA;MACA;MACA,KAAAE,gBAAA;IACA;IACAmB,eAAAC,OAAA;MACA,KAAAA,OAAA;MACA,MAAAC,IAAA,OAAAC,IAAA,CAAAF,OAAA;MACA,OAAAC,IAAA,CAAAE,cAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}