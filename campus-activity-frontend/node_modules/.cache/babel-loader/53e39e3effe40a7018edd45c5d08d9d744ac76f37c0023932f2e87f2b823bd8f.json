signScoreApi.getTotalScore(userId)\n        if (res.code === 200) {\n          this.totalScore = res.data || 0\n        }\n      } catch (error) {\n        console.error('加载总积分失败:', error)\n      }\n    },\n    handleEvaluate(row) {\n      // 跳转到评价页面\n      this.$router.push(`/student/evaluation/${row.activityId}`)\n    },\n    formatDateTime(dateStr) {\n      if (!dateStr) return ''\n      const date = new Date(dateStr)\n      return date.toLocaleString('zh-CN')\n    }\n  }\n}\n</script>\n\n<style scoped>\n.my-sign-score {\n  padding: 20px;\n}\n\n.score-summary {\n  margin-bottom: 20px;\n}\n\n.summary-card {\n  max-width: 300px;\n}\n\n.summary-content {\n  text-align: center;\n}\n\n.summary-label {\n  font-size: 14px;\n  color: #909399;\n  margin-bottom: 10px;\n}\n\n.summary-value {\n  font-size: 36px;\n  font-weight: bold;\n  color: #409EFF;\n}\n</style>\n"],"mappings":"AAuCA,SAAAA,YAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,aAAA;MACAC,UAAA;MACAC,OAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,iBAAA;IACA,KAAAC,cAAA;EACA;EACAC,OAAA;IACA,MAAAF,kBAAA;MACA,KAAAF,OAAA;MACA;QACA,MAAAK,MAAA,QAAAC,MAAA,CAAAC,KAAA,CAAAC,IAAA,CAAAH,MAAA;QACA,MAAAI,GAAA,SAAAd,YAAA,CAAAe,WAAA,CAAAL,MAAA;QACA,IAAAI,GAAA,CAAAE,IAAA;UACA,KAAAb,aAAA,GAAAW,GAAA,CAAAZ,IAAA;QACA;MACA,SAAAe,KAAA;QACAC,OAAA,CAAAD,KAAA,cAAAA,KAAA;MACA;QACA,KAAAZ,OAAA;MACA;IACA;IACA,MAAAG,eAAA;MACA;QACA,MAAAE,MAAA,QAAAC,MAAA,CAAAC,KAAA,CAAAC,IAAA,CAAAH,MAAA;QACA,MAAAI,GAAA,SAAAd,YAAA,CAAAmB,aAAA,CAAAT,MAAA;QACA,IAAAI,GAAA,CAAAE,IAAA;UACA,KAAAZ,UAAA,GAAAU,GAAA,CAAAZ,IAAA;QACA;MACA,SAAAe,KAAA;QACAC,OAAA,CAAAD,KAAA,aAAAA,KAAA;MACA;IACA;IACAG,eAAAC,GAAA;MACA;MACA,KAAAC,OAAA,CAAAC,IAAA,wBAAAF,GAAA,CAAAG,UAAA;IACA;IACAC,eAAAC,OAAA;MACA,KAAAA,OAAA;MACA,MAAAC,IAAA,OAAAC,IAAA,CAAAF,OAAA;MACA,OAAAC,IAAA,CAAAE,cAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}