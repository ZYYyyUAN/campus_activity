{"ast":null,"code":"import { activityApi } from '@/api';\nexport default {\n  name: 'ActivityList',\n  data() {\n    return {\n      activityList: [],\n      loading: false,\n      searchForm: {\n        activityType: '',\n        keyword: '',\n        timeRange: null\n      }\n    };\n  },\n  computed: {\n    isAdmin() {\n      return this.$store.getters.isAdmin;\n    },\n    isPublisher() {\n      return this.$store.getters.isPublisher;\n    },\n    isStudent() {\n      return this.$store.getters.isStudent;\n    },\n    currentUserId() {\n      return this.$store.state.user ? this.$store.state.user.userId : null;\n    }\n  },\n  mounted() {\n    this.loadActivityList();\n  },\n  methods: {\n    async loadActivityList() {\n      this.loading = true;\n      try {\n        let res;\n        // 发布者只显示自己发布的活动\n        if (this.isPublisher && !this.isAdmin) {\n          const publisherId = this.$store.state.user.userId;\n          res = await activityApi.getActivityByPublisher(publisherId);\n        } else {\n          res = await activityApi.getActivityList();\n        }\n        if (res.code === 200) {\n          this.activityList = res.data || [];\n        }\n      } catch (error) {\n        console.error('加载活动列表失败:', error);\n      } finally {\n        this.loading = false;\n      }\n    },\n    handleAdd() {\n      this.$router.push('/activity/add');\n    },\n    handleEdit(row) {\n      this.$router.push(`/activity/edit/${row.activityId}`);\n    },\n    handleDelete(row) {\n      this.$confirm(`确定要删除活动\"${row.activityName}\"吗?`, '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(async () => {\n        try {\n          const res = await activityApi.deleteActivity(row.activityId);\n          if (res.code === 200) {\n            this.$message.success('删除成功');\n            this.loadActivityList();\n          }\n        } catch (error) {\n          console.error('删除失败:', error);\n        }\n      });\n    },\n    async handleSearch() {\n      this.loading = true;\n      try {\n        const params = {\n          activityType: this.searchForm.activityType || null,\n          keyword: this.searchForm.keyword || null\n        };\n\n        // 如果选择了时间范围\n        if (this.searchForm.timeRange && this.searchForm.timeRange.length === 2) {\n          params.startTime = this.searchForm.timeRange[0];\n          params.endTime = this.searchForm.timeRange[1];\n        }\n        const res = await activityApi.queryActivity(params);\n        if (res.code === 200) {\n          this.activityList = res.data || [];\n        } else {\n          this.$message.error(res.message || '查询失败');\n        }\n      } catch (error) {\n        console.error('查询失败:', error);\n        this.$message.error('查询失败，请重试');\n      } finally {\n        this.loading = false;\n      }\n    },\n    handleReset() {\n      this.searchForm = {\n        activityType: '',\n        keyword: '',\n        timeRange: null\n      };\n      // 重置后加载所有活动\n      this.loadActivityList();\n    },\n    formatDateTime(dateStr) {\n      if (!dateStr) return '';\n      const date = new Date(dateStr);\n      return date.toLocaleString('zh-CN', {\n        year: 'numeric',\n        month: '2-digit',\n        day: '2-digit',\n        hour: '2-digit',\n        minute: '2-digit'\n      });\n    }\n  }\n};","map":{"version":3,"names":["activityApi","name","data","activityList","loading","searchForm","activityType","keyword","timeRange","computed","isAdmin","$store","getters","isPublisher","isStudent","currentUserId","state","user","userId","mounted","loadActivityList","methods","res","publisherId","getActivityByPublisher","getActivityList","code","error","console","handleAdd","$router","push","handleEdit","row","activityId","handleDelete","$confirm","activityName","confirmButtonText","cancelButtonText","type","then","deleteActivity","$message","success","handleSearch","params","length","startTime","endTime","queryActivity","message","handleReset","formatDateTime","dateStr","date","Date","toLocaleString","year","month","day","hour","minute"],"sources":["src/views/activity/ActivityList.vue"],"sourcesContent":["<template>\n  <div class=\"activity-list\">\n    <el-card>\n      <div slot=\"header\" class=\"card-header\">\n        <span>活动列表</span>\n        <el-button \n          type=\"primary\" \n          icon=\"el-icon-plus\" \n          @click=\"handleAdd\"\n          v-if=\"isAdmin || isPublisher\">新增活动</el-button>\n      </div>\n      \n      <!-- 搜索栏 -->\n      <el-form :inline=\"true\" :model=\"searchForm\" class=\"search-form\">\n        <el-form-item label=\"活动类型\">\n          <el-select v-model=\"searchForm.activityType\" placeholder=\"请选择\" clearable>\n            <el-option label=\"讲座\" value=\"讲座\"></el-option>\n            <el-option label=\"比赛\" value=\"比赛\"></el-option>\n            <el-option label=\"学术论坛\" value=\"学术论坛\"></el-option>\n            <el-option label=\"班级活动\" value=\"班级活动\"></el-option>\n            <el-option label=\"志愿服务\" value=\"志愿服务\"></el-option>\n          </el-select>\n        </el-form-item>\n        <el-form-item label=\"时间范围\">\n          <el-date-picker\n            v-model=\"searchForm.timeRange\"\n            type=\"datetimerange\"\n            range-separator=\"至\"\n            start-placeholder=\"开始时间\"\n            end-placeholder=\"结束时间\"\n            value-format=\"yyyy-MM-dd HH:mm:ss\">\n          </el-date-picker>\n        </el-form-item>\n        <el-form-item label=\"关键词\">\n          <el-input v-model=\"searchForm.keyword\" placeholder=\"活动名称/地点\" clearable></el-input>\n        </el-form-item>\n        <el-form-item>\n          <el-button type=\"primary\" icon=\"el-icon-search\" @click=\"handleSearch\">查询</el-button>\n          <el-button icon=\"el-icon-refresh\" @click=\"handleReset\">重置</el-button>\n        </el-form-item>\n      </el-form>\n      \n      <!-- 活动表格 -->\n      <el-table :data=\"activityList\" border style=\"width: 100%\" v-loading=\"loading\">\n        <el-table-column type=\"index\" label=\"序号\" width=\"60\"></el-table-column>\n        <el-table-column prop=\"activityName\" label=\"活动名称\" min-width=\"150\"></el-table-column>\n        <el-table-column prop=\"activityType\" label=\"活动类型\" width=\"120\" sortable></el-table-column>\n        <el-table-column prop=\"location\" label=\"活动地点\" width=\"150\"></el-table-column>\n        <el-table-column prop=\"startTime\" label=\"开始时间\" width=\"180\" sortable>\n          <template slot-scope=\"scope\">\n            {{ formatDateTime(scope.row.startTime) }}\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"endTime\" label=\"结束时间\" width=\"180\" sortable>\n          <template slot-scope=\"scope\">\n            {{ formatDateTime(scope.row.endTime) }}\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"maxPeople\" label=\"人数上限\" width=\"100\" sortable></el-table-column>\n        <el-table-column prop=\"publisherName\" label=\"发布者\" width=\"120\" sortable></el-table-column>\n        <el-table-column prop=\"status\" label=\"状态\" width=\"100\" sortable>\n          <template slot-scope=\"scope\">\n            <el-tag :type=\"scope.row.status === '报名中' ? 'success' : 'info'\">\n              {{ scope.row.status }}\n            </el-tag>\n          </template>\n        </el-table-column>\n        <el-table-column label=\"操作\" width=\"200\" fixed=\"right\">\n          <template slot-scope=\"scope\">\n            <el-button \n              size=\"mini\" \n              @click=\"handleEdit(scope.row)\"\n              v-if=\"isAdmin || (isPublisher && scope.row.publisherId === currentUserId)\">编辑</el-button>\n            <el-button \n              size=\"mini\" \n              type=\"danger\" \n              @click=\"handleDelete(scope.row)\"\n              v-if=\"isAdmin || (isPublisher && scope.row.publisherId === currentUserId)\">删除</el-button>\n            <span v-if=\"isStudent\">-</span>\n          </template>\n        </el-table-column>\n      </el-table>\n    </el-card>\n  </div>\n</template>\n\n<script>\nimport { activityApi } from '@/api'\n\nexport default {\n  name: 'ActivityList',\n  data() {\n    return {\n      activityList: [],\n      loading: false,\n      searchForm: {\n        activityType: '',\n        keyword: '',\n        timeRange: null\n      }\n    }\n  },\n  computed: {\n    isAdmin() {\n      return this.$store.getters.isAdmin\n    },\n    isPublisher() {\n      return this.$store.getters.isPublisher\n    },\n    isStudent() {\n      return this.$store.getters.isStudent\n    },\n    currentUserId() {\n      return this.$store.state.user ? this.$store.state.user.userId : null\n    }\n  },\n  mounted() {\n    this.loadActivityList()\n  },\n  methods: {\n    async loadActivityList() {\n      this.loading = true\n      try {\n        let res\n        // 发布者只显示自己发布的活动\n        if (this.isPublisher && !this.isAdmin) {\n          const publisherId = this.$store.state.user.userId\n          res = await activityApi.getActivityByPublisher(publisherId)\n        } else {\n          res = await activityApi.getActivityList()\n        }\n        if (res.code === 200) {\n          this.activityList = res.data || []\n        }\n      } catch (error) {\n        console.error('加载活动列表失败:', error)\n      } finally {\n        this.loading = false\n      }\n    },\n    handleAdd() {\n      this.$router.push('/activity/add')\n    },\n    handleEdit(row) {\n      this.$router.push(`/activity/edit/${row.activityId}`)\n    },\n    handleDelete(row) {\n      this.$confirm(`确定要删除活动\"${row.activityName}\"吗?`, '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(async () => {\n        try {\n          const res = await activityApi.deleteActivity(row.activityId)\n          if (res.code === 200) {\n            this.$message.success('删除成功')\n            this.loadActivityList()\n          }\n        } catch (error) {\n          console.error('删除失败:', error)\n        }\n      })\n    },\n    async handleSearch() {\n      this.loading = true\n      try {\n        const params = {\n          activityType: this.searchForm.activityType || null,\n          keyword: this.searchForm.keyword || null\n        }\n        \n        // 如果选择了时间范围\n        if (this.searchForm.timeRange && this.searchForm.timeRange.length === 2) {\n          params.startTime = this.searchForm.timeRange[0]\n          params.endTime = this.searchForm.timeRange[1]\n        }\n        \n        const res = await activityApi.queryActivity(params)\n        if (res.code === 200) {\n          this.activityList = res.data || []\n        } else {\n          this.$message.error(res.message || '查询失败')\n        }\n      } catch (error) {\n        console.error('查询失败:', error)\n        this.$message.error('查询失败，请重试')\n      } finally {\n        this.loading = false\n      }\n    },\n    handleReset() {\n      this.searchForm = {\n        activityType: '',\n        keyword: '',\n        timeRange: null\n      }\n      // 重置后加载所有活动\n      this.loadActivityList()\n    },\n    formatDateTime(dateStr) {\n      if (!dateStr) return ''\n      const date = new Date(dateStr)\n      return date.toLocaleString('zh-CN', {\n        year: 'numeric',\n        month: '2-digit',\n        day: '2-digit',\n        hour: '2-digit',\n        minute: '2-digit'\n      })\n    }\n  }\n}\n</script>\n\n<style scoped>\n.activity-list {\n  padding: 20px;\n}\n\n.card-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.search-form {\n  margin-bottom: 20px;\n}\n</style>\n\n"],"mappings":"AAuFA,SAAAA,WAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,YAAA;MACAC,OAAA;MACAC,UAAA;QACAC,YAAA;QACAC,OAAA;QACAC,SAAA;MACA;IACA;EACA;EACAC,QAAA;IACAC,QAAA;MACA,YAAAC,MAAA,CAAAC,OAAA,CAAAF,OAAA;IACA;IACAG,YAAA;MACA,YAAAF,MAAA,CAAAC,OAAA,CAAAC,WAAA;IACA;IACAC,UAAA;MACA,YAAAH,MAAA,CAAAC,OAAA,CAAAE,SAAA;IACA;IACAC,cAAA;MACA,YAA