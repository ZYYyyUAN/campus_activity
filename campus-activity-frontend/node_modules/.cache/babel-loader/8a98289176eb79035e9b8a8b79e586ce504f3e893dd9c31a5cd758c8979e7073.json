{"ast":null,"code":"import { evaluationApi } from '@/api';\nexport default {\n  name: 'EvaluationList',\n  data() {\n    return {\n      evaluationList: [],\n      displayList: [],\n      loading: false,\n      keyword: '',\n      sortOrder: ''\n    };\n  },\n  computed: {\n    totalCount() {\n      return this.displayList.length;\n    },\n    averageRating() {\n      if (this.displayList.length === 0) return 0;\n      const sum = this.displayList.reduce((acc, item) => acc + item.rating, 0);\n      return sum / this.displayList.length;\n    },\n    maxRating() {\n      if (this.displayList.length === 0) return 0;\n      return Math.max(...this.displayList.map(item => item.rating));\n    },\n    minRating() {\n      if (this.displayList.length === 0) return 0;\n      return Math.min(...this.displayList.map(item => item.rating));\n    }\n  },\n  mounted() {\n    this.loadEvaluationList();\n  },\n  methods: {\n    async loadEvaluationList() {\n      this.loading = true;\n      try {\n        const res = await evaluationApi.getAllEvaluations();\n        if (res.code === 200) {\n          this.evaluationList = res.data || [];\n          this.displayList = [...this.evaluationList];\n        } else {\n          this.$message.error(res.message || '加载失败');\n        }\n      } catch (error) {\n        console.error('加载评价列表失败:', error);\n        this.$message.error('加载失败，请重试');\n      } finally {\n        this.loading = false;\n      }\n    },\n    async handleSearch() {\n      if (!this.keyword.trim()) {\n        this.displayList = [...this.evaluationList];\n        this.handleSort();\n        return;\n      }\n      this.loading = true;\n      try {\n        const res = await evaluationApi.getEvaluationByKeyword(this.keyword);\n        if (res.code === 200) {\n          this.displayList = res.data || [];\n          this.handleSort();\n        } else {\n          this.$message.error(res.message || '查询失败');\n        }\n      } catch (error) {\n        console.error('搜索失败:', error);\n        this.$message.error('搜索失败，请重试');\n      } finally {\n        this.loading = false;\n      }\n    },\n    handleSort() {\n      if (!this.sortOrder) {\n        return;\n      }\n      this.displayList.sort((a, b) => {\n        if (this.sortOrder === 'desc') {\n          return b.rating - a.rating;\n        } else if (this.sortOrder === 'asc') {\n          return a.rating - b.rating;\n        }\n        return 0;\n      });\n    },\n    handleReset() {\n      this.keyword = '';\n      this.sortOrder = '';\n      this.displayList = [...this.evaluationList];\n    },\n    formatDateTime(dateStr) {\n      if (!dateStr) return '';\n      const date = new Date(dateStr);\n      return date.toLocaleString('zh-CN');\n    }\n  }\n};","map":{"version":3,"names":["evaluationApi","name","data","evaluationList","displayList","loading","keyword","sortOrder","computed","totalCount","length","averageRating","sum","reduce","acc","item","rating","maxRating","Math","max","map","minRating","min","mounted","loadEvaluationList","methods","res","getAllEvaluations","code","$message","error","message","console","handleSearch","trim","handleSort","getEvaluationByKeyword","sort","a","b","handleReset","formatDateTime","dateStr","date","Date","toLocaleString"],"sources":["src/views/evaluation/EvaluationList.vue"],"sourcesContent":["<template>\r\n  <div class=\"evaluation-list\">\r\n    <el-card>\r\n      <div slot=\"header\">\r\n        <span>评价管理</span>\r\n      </div>\r\n      \r\n      <!-- 统计信息 -->\r\n      <el-row :gutter=\"20\" class=\"statistics\">\r\n        <el-col :span=\"6\">\r\n          <el-card shadow=\"hover\">\r\n            <div class=\"stat-item\">\r\n              <div class=\"stat-label\">总评价数</div>\r\n              <div class=\"stat-value\">{{ totalCount }}</div>\r\n            </div>\r\n          </el-card>\r\n        </el-col>\r\n        <el-col :span=\"6\">\r\n          <el-card shadow=\"hover\">\r\n            <div class=\"stat-item\">\r\n              <div class=\"stat-label\">平均评分</div>\r\n              <div class=\"stat-value\">{{ averageRating.toFixed(1) }}</div>\r\n            </div>\r\n          </el-card>\r\n        </el-col>\r\n        <el-col :span=\"6\">\r\n          <el-card shadow=\"hover\">\r\n            <div class=\"stat-item\">\r\n              <div class=\"stat-label\">最高评分</div>\r\n              <div class=\"stat-value\">{{ maxRating }}</div>\r\n            </div>\r\n          </el-card>\r\n        </el-col>\r\n        <el-col :span=\"6\">\r\n          <el-card shadow=\"hover\">\r\n            <div class=\"stat-item\">\r\n              <div class=\"stat-label\">最低评分</div>\r\n              <div class=\"stat-value\">{{ minRating }}</div>\r\n            </div>\r\n          </el-card>\r\n        </el-col>\r\n      </el-row>\r\n      \r\n      <!-- 搜索栏 -->\r\n      <el-form :inline=\"true\" class=\"search-form\">\r\n        <el-form-item label=\"关键词搜索\">\r\n          <el-input \r\n            v-model=\"keyword\" \r\n            placeholder=\"请输入评价内容关键词\" \r\n            clearable\r\n            @input=\"handleSearch\">\r\n          </el-input>\r\n        </el-form-item>\r\n        <el-form-item label=\"评分排序\">\r\n          <el-select v-model=\"sortOrder\" @change=\"handleSort\" placeholder=\"请选择\">\r\n            <el-option label=\"默认排序\" value=\"\"></el-option>\r\n            <el-option label=\"评分从高到低\" value=\"desc\"></el-option>\r\n            <el-option label=\"评分从低到高\" value=\"asc\"></el-option>\r\n          </el-select>\r\n        </el-form-item>\r\n        <el-form-item>\r\n          <el-button type=\"primary\" icon=\"el-icon-search\" @click=\"handleSearch\">查询</el-button>\r\n          <el-button icon=\"el-icon-refresh\" @click=\"handleReset\">重置</el-button>\r\n        </el-form-item>\r\n      </el-form>\r\n      \r\n      <!-- 评价表格 -->\r\n      <el-table :data=\"displayList\" border v-loading=\"loading\" style=\"width: 100%\">\r\n        <el-table-column type=\"index\" label=\"序号\" width=\"60\"></el-table-column>\r\n        <el-table-column prop=\"activityName\" label=\"活动名称\" min-width=\"150\"></el-table-column>\r\n        <el-table-column prop=\"realName\" label=\"评价人\" width=\"100\"></el-table-column>\r\n        <el-table-column prop=\"userName\" label=\"学号\" width=\"120\"></el-table-column>\r\n        <el-table-column prop=\"rating\" label=\"评分\" width=\"150\" sortable>\r\n          <template slot-scope=\"scope\">\r\n            <el-rate v-model=\"scope.row.rating\" disabled show-score></el-rate>\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column prop=\"content\" label=\"评价内容\" min-width=\"250\" show-overflow-tooltip></el-table-column>\r\n        <el-table-column prop=\"evalTime\" label=\"评价时间\" width=\"180\">\r\n          <template slot-scope=\"scope\">\r\n            {{ formatDateTime(scope.row.evalTime) }}\r\n          </template>\r\n        </el-table-column>\r\n      </el-table>\r\n    </el-card>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { evaluationApi } from '@/api'\r\n\r\nexport default {\r\n  name: 'EvaluationList',\r\n  data() {\r\n    return {\r\n      evaluationList: [],\r\n      displayList: [],\r\n      loading: false,\r\n      keyword: '',\r\n      sortOrder: ''\r\n    }\r\n  },\r\n  computed: {\r\n    totalCount() {\r\n      return this.displayList.length\r\n    },\r\n    averageRating() {\r\n      if (this.displayList.length === 0) return 0\r\n      const sum = this.displayList.reduce((acc, item) => acc + item.rating, 0)\r\n      return sum / this.displayList.length\r\n    },\r\n    maxRating() {\r\n      if (this.displayList.length === 0) return 0\r\n      return Math.max(...this.displayList.map(item => item.rating))\r\n    },\r\n    minRating() {\r\n      if (this.displayList.length === 0) return 0\r\n      return Math.min(...this.displayList.map(item => item.rating))\r\n    }\r\n  },\r\n  mounted() {\r\n    this.loadEvaluationList()\r\n  },\r\n  methods: {\r\n    async loadEvaluationList() {\r\n      this.loading = true\r\n      try {\r\n        const res = await evaluationApi.getAllEvaluations()\r\n        if (res.code === 200) {\r\n          this.evaluationList = res.data || []\r\n          this.displayList = [...this.evaluationList]\r\n        } else {\r\n          this.$message.error(res.message || '加载失败')\r\n        }\r\n      } catch (error) {\r\n        console.error('加载评价列表失败:', error)\r\n        this.$message.error('加载失败，请重试')\r\n      } finally {\r\n        this.loading = false\r\n      }\r\n    },\r\n    async handleSearch() {\r\n      if (!this.keyword.trim()) {\r\n        this.displayList = [...this.evaluationList]\r\n        this.handleSort()\r\n        return\r\n      }\r\n      \r\n      this.loading = true\r\n      try {\r\n        const res = await evaluationApi.getEvaluationByKeyword(this.keyword)\r\n        if (res.code === 200) {\r\n          this.displayList = res.data || []\r\n          this.handleSort()\r\n        } else {\r\n          this.$message.error(res.message || '查询失败')\r\n        }\r\n      } catch (error) {\r\n        console.error('搜索失败:', error)\r\n        this.$message.error('搜索失败，请重试')\r\n      } finally {\r\n        this.loading = false\r\n      }\r\n    },\r\n    handleSort() {\r\n      if (!this.sortOrder) {\r\n        return\r\n      }\r\n      \r\n      this.displayList.sort((a, b) => {\r\n        if (this.sortOrder === 'desc') {\r\n          return b.rating - a.rating\r\n        } else if (this.sortOrder === 'asc') {\r\n          return a.rating - b.rating\r\n        }\r\n        return 0\r\n      })\r\n    },\r\n    handleReset() {\r\n      this.keyword = ''\r\n      this.sortOrder = ''\r\n      this.displayList = [...this.evaluationList]\r\n    },\r\n    formatDateTime(dateStr) {\r\n      if (!dateStr) return ''\r\n      const date = new Date(dateStr)\r\n      return date.toLocaleString('zh-CN')\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.evaluation-list {\r\n  padding: 20px;\r\n}\r\n\r\n.statistics {\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.stat-item {\r\n  text-align: center;\r\n}\r\n\r\n.stat-label {\r\n  font-size: 14px;\r\n  color: #909399;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.stat-value {\r\n  font-size: 28px;\r\n  font-weight: bold;\r\n  color: #409EFF;\r\n}\r\n\r\n.search-form {\r\n  margin-bottom: 20px;\r\n}\r\n</style>\r\n"],"mappings":"AAyFA,SAAAA,aAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,cAAA;MACAC,WAAA;MACAC,OAAA;MACAC,OAAA;MACAC,SAAA;IACA;EACA;EACAC,QAAA;IACAC,WAAA;MACA,YAAAL,WAAA,CAAAM,MAAA;IACA;IACAC,cAAA;MACA,SAAAP,WAAA,CAAAM,MAAA;MACA,MAAAE,GAAA,QAAAR,WAAA,CAAAS,MAAA,EAAAC,GAAA,EAAAC,IAAA,KAAAD,GAAA,GAAAC,IAAA,CAAAC,MAAA;MACA,OAAAJ,GAAA,QAAAR,WAAA,CAAAM,MAAA;IACA;IACAO,UAAA;MACA,SAAAb,WAAA,CAAAM,MAAA;MACA,OAAAQ,IAAA,CAAAC,GAAA,SAAAf,WAAA,CAAAgB,GAAA,CAAAL,IAAA,IAAAA,IAAA,CAAAC,MAAA;IACA;IACAK,UAAA;MACA,SAAAjB,WAAA,CAAAM,MAAA;MACA,OAAAQ,IAAA,CAAAI,GAAA,SAAAlB,WAAA,CAAAgB,GAAA,CAAAL,IAAA,IAAAA,IAAA,CAAAC,MAAA;IACA;EACA;EACAO,QAAA;IACA,KAAAC,kBAAA;EACA;EACAC,OAAA;IACA,MAAAD,mBAAA;MACA,KAAAnB,OAAA;MACA;QACA,MAAAqB,GAAA,SAAA1B,aAAA,CAAA2B,iBAAA;QACA,IAAAD,GAAA,CAAAE,IAAA;UACA,KAAAzB,cAAA,GAAAuB,GAAA,CAAAxB,IAAA;UACA,KAAAE,WAAA,YAAAD,cAAA;QACA;UACA,KAAA0B,QAAA,CAAAC,KAAA,CAAAJ,GAAA,CAAAK,OAAA;QACA;MACA,SAAAD,KAAA;QACAE,OAAA,CAAAF,KAAA,cAAAA,KAAA;QACA,KAAAD,QAAA,CAAAC,KAAA;MACA;QACA,KAAAzB,OAAA;MACA;IACA;IACA,MAAA4B,aAAA;MACA,UAAA3B,OAAA,CAAA4B,IAAA;QACA,KAAA9B,WAAA,YAAAD,cAAA;QACA,KAAAgC,UAAA;QACA;MACA;MAEA,KAAA9B,OAAA;MACA;QACA,MAAAqB,GAAA,SAAA1B,aAAA,CAAAoC,sBAAA,MAAA9B,OAAA;QACA,IAAAoB,GAAA,CAAAE,IAAA;UACA,KAAAxB,WAAA,GAAAsB,GAAA,CAAAxB,IAAA;UACA,KAAAiC,UAAA;QACA;UACA,KAAAN,QAAA,CAAAC,KAAA,CAAAJ,GAAA,CAAAK,OAAA;QACA;MACA,SAAAD,KAAA;QACAE,OAAA,CAAAF,KAAA,UAAAA,KAAA;QACA,KAAAD,QAAA,CAAAC,KAAA;MACA;QACA,KAAAzB,OAAA;MACA;IACA;IACA8B,WAAA;MACA,UAAA5B,SAAA;QACA;MACA;MAEA,KAAAH,WAAA,CAAAiC,IAAA,EAAAC,CAAA,EAAAC,CAAA;QACA,SAAAhC,SAAA;UACA,OAAAgC,CAAA,CAAAvB,MAAA,GAAAsB,CAAA,CAAAtB,MAAA;QACA,gBAAAT,SAAA;UACA,OAAA+B,CAAA,CAAAtB,MAAA,GAAAuB,CAAA,CAA