{"ast":null,"code":"import { activityApi, registrationApi, signScoreApi, evaluationApi } from '@/api';\nexport default {\n  name: 'ActivityDetail',\n  data() {\n    return {\n      activityId: null,\n      activity: null,\n      registrationList: [],\n      signList: [],\n      evaluationList: [],\n      registrationCount: 0,\n      signCount: 0,\n      loading: false\n    };\n  },\n  computed: {\n    signRate() {\n      if (this.registrationCount === 0) return 0;\n      return (this.signCount / this.registrationCount * 100).toFixed(1);\n    }\n  },\n  mounted() {\n    this.activityId = parseInt(this.$route.params.id);\n    this.loadData();\n  },\n  methods: {\n    async loadData() {\n      this.loading = true;\n      try {\n        // 加载活动信息\n        await this.loadActivity();\n        // 先加载签到列表\n        await this.loadSigns();\n        // 再加载报名列表（需要用到签到列表数据）\n        await this.loadRegistrations();\n        // 加载评价列表\n        await this.loadEvaluations();\n      } catch (error) {\n        console.error('加载数据失败:', error);\n      } finally {\n        this.loading = false;\n      }\n    },\n    async loadActivity() {\n      const res = await activityApi.getActivityById(this.activityId);\n      if (res.code === 200) {\n        this.activity = res.data;\n      }\n    },\n    async loadRegistrations() {\n      const res = await registrationApi.getRegistrationByActivity(this.activityId);\n      if (res.code === 200) {\n        this.registrationList = res.data || [];\n        this.registrationCount = this.registrationList.length;\n\n        // 为每个报名记录添加是否签到的标识，使用$set确保响应式\n        this.registrationList.forEach(reg => {\n          const hasSigned = this.signList.some(sign => sign.userId != null && reg.userId != null && Number(sign.userId) === Number(reg.userId));\n          this.$set(reg, 'hasSigned', hasSigned);\n        });\n      }\n    },\n    async loadSigns() {\n      const res = await signScoreApi.getSignListByActivity(this.activityId);\n      if (res.code === 200) {\n        this.signList = res.data || [];\n        this.signCount = this.signList.length;\n      }\n    },\n    async loadEvaluations() {\n      const res = await evaluationApi.getEvaluationList(this.activityId);\n      if (res.code === 200) {\n        this.evaluationList = res.data || [];\n      }\n    },\n    goBack() {\n      this.$router.go(-1);\n    },\n    getStatusType(status) {\n      const map = {\n        '待审': 'warning',\n        '通过': 'success',\n        '拒绝': 'danger'\n      };\n      return map[status] || 'info';\n    },\n    formatDateTime(dateStr) {\n      if (!dateStr) return '';\n      const date = new Date(dateStr);\n      return date.toLocaleString('zh-CN');\n    }\n  }\n};","map":{"version":3,"names":["activityApi","registrationApi","signScoreApi","evaluationApi","name","data","activityId","activity","registrationList","signList","evaluationList","registrationCount","signCount","loading","computed","signRate","toFixed","mounted","parseInt","$route","params","id","loadData","methods","loadActivity","loadSigns","loadRegistrations","loadEvaluations","error","console","res","getActivityById","code","getRegistrationByActivity","length","forEach","reg","hasSigned","some","sign","userId","Number","$set","getSignListByActivity","getEvaluationList","goBack","$router","go","getStatusType","status","map","formatDateTime","dateStr","date","Date","toLocaleString"],"sources":["src/views/activity/ActivityDetail.vue"],"sourcesContent":["<template>\n  <div class=\"activity-detail\">\n    <el-card>\n      <div slot=\"header\">\n        <el-page-header @back=\"goBack\" content=\"活动详情\"></el-page-header>\n      </div>\n\n      <!-- 活动基本信息 -->\n      <div v-if=\"activity\" class=\"detail-section\">\n        <h3>活动信息</h3>\n        <el-descriptions :column=\"2\" border>\n          <el-descriptions-item label=\"活动名称\">{{ activity.activityName }}</el-descriptions-item>\n          <el-descriptions-item label=\"活动类型\">{{ activity.activityType }}</el-descriptions-item>\n          <el-descriptions-item label=\"活动地点\">{{ activity.location }}</el-descriptions-item>\n          <el-descriptions-item label=\"活动状态\">\n            <el-tag :type=\"activity.status === '报名中' ? 'success' : 'info'\">\n              {{ activity.status }}\n            </el-tag>\n          </el-descriptions-item>\n          <el-descriptions-item label=\"开始时间\">{{ formatDateTime(activity.startTime) }}</el-descriptions-item>\n          <el-descriptions-item label=\"结束时间\">{{ formatDateTime(activity.endTime) }}</el-descriptions-item>\n          <el-descriptions-item label=\"人数上限\">{{ activity.maxPeople }}</el-descriptions-item>\n          <el-descriptions-item label=\"发布者\">{{ activity.publisherName }}</el-descriptions-item>\n        </el-descriptions>\n      </div>\n\n      <!-- 参与统计 -->\n      <div class=\"detail-section\">\n        <h3>参与统计</h3>\n        <el-row :gutter=\"20\">\n          <el-col :span=\"8\">\n            <el-card shadow=\"hover\">\n              <div class=\"stat-card\">\n                <div class=\"stat-label\">报名人数</div>\n                <div class=\"stat-value\">{{ registrationCount }}</div>\n              </div>\n            </el-card>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-card shadow=\"hover\">\n              <div class=\"stat-card\">\n                <div class=\"stat-label\">签到人数</div>\n                <div class=\"stat-value\">{{ signCount }}</div>\n              </div>\n            </el-card>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-card shadow=\"hover\">\n              <div class=\"stat-card\">\n                <div class=\"stat-label\">签到率</div>\n                <div class=\"stat-value\">{{ signRate }}%</div>\n              </div>\n            </el-card>\n          </el-col>\n        </el-row>\n      </div>\n\n      <!-- 报名列表 -->\n      <div class=\"detail-section\">\n        <h3>报名列表</h3>\n        <el-table :data=\"registrationList\" border v-loading=\"loading\">\n          <el-table-column type=\"index\" label=\"序号\" width=\"60\"></el-table-column>\n          <el-table-column prop=\"realName\" label=\"学生姓名\" width=\"120\"></el-table-column>\n          <el-table-column prop=\"userName\" label=\"用户名\" width=\"150\"></el-table-column>\n          <el-table-column prop=\"registerTime\" label=\"报名时间\" width=\"180\">\n            <template slot-scope=\"scope\">\n              {{ formatDateTime(scope.row.registerTime) }}\n            </template>\n          </el-table-column>\n          <el-table-column prop=\"auditStatus\" label=\"审核状态\" width=\"120\">\n            <template slot-scope=\"scope\">\n              <el-tag :type=\"getStatusType(scope.row.auditStatus)\">\n                {{ scope.row.auditStatus }}\n              </el-tag>\n            </template>\n          </el-table-column>\n          <el-table-column label=\"是否签到\" width=\"120\">\n            <template slot-scope=\"scope\">\n              <el-tag :type=\"scope.row.hasSigned ? 'success' : 'info'\">\n                {{ scope.row.hasSigned ? '已签到' : '未签到' }}\n              </el-tag>\n            </template>\n          </el-table-column>\n        </el-table>\n      </div>\n\n      <!-- 签到列表 -->\n      <div class=\"detail-section\">\n        <h3>签到记录</h3>\n        <el-table :data=\"signList\" border v-loading=\"loading\">\n          <el-table-column type=\"index\" label=\"序号\" width=\"60\"></el-table-column>\n          <el-table-column prop=\"realName\" label=\"学生姓名\" width=\"120\"></el-table-column>\n          <el-table-column prop=\"userName\" label=\"用户名\" width=\"150\"></el-table-column>\n          <el-table-column prop=\"signTime\" label=\"签到时间\" width=\"180\">\n            <template slot-scope=\"scope\">\n              {{ formatDateTime(scope.row.signTime) }}\n            </template>\n          </el-table-column>\n          <el-table-column prop=\"score\" label=\"获得积分\" width=\"120\">\n            <template slot-scope=\"scope\">\n              <el-tag type=\"success\">+{{ scope.row.score }}</el-tag>\n            </template>\n          </el-table-column>\n        </el-table>\n      </div>\n\n      <!-- 评价列表 -->\n      <div class=\"detail-section\">\n        <h3>活动评价</h3>\n        <el-table :data=\"evaluationList\" border v-loading=\"loading\">\n          <el-table-column type=\"index\" label=\"序号\" width=\"60\"></el-table-column>\n          <el-table-column prop=\"realName\" label=\"学生姓名\" width=\"120\"></el-table-column>\n          <el-table-column prop=\"rating\" label=\"评分\" width=\"150\">\n            <template slot-scope=\"scope\">\n              <el-rate v-model=\"scope.row.rating\" disabled></el-rate>\n            </template>\n          </el-table-column>\n          <el-table-column prop=\"content\" label=\"评价内容\" min-width=\"200\"></el-table-column>\n          <el-table-column prop=\"evalTime\" label=\"评价时间\" width=\"180\">\n            <template slot-scope=\"scope\">\n              {{ formatDateTime(scope.row.evalTime) }}\n            </template>\n          </el-table-column>\n        </el-table>\n      </div>\n    </el-card>\n  </div>\n</template>\n\n<script>\nimport { activityApi, registrationApi, signScoreApi, evaluationApi } from '@/api'\n\nexport default {\n  name: 'ActivityDetail',\n  data() {\n    return {\n      activityId: null,\n      activity: null,\n      registrationList: [],\n      signList: [],\n      evaluationList: [],\n      registrationCount: 0,\n      signCount: 0,\n      loading: false\n    }\n  },\n  computed: {\n    signRate() {\n      if (this.registrationCount === 0) return 0\n      return ((this.signCount / this.registrationCount) * 100).toFixed(1)\n    }\n  },\n  mounted() {\n    this.activityId = parseInt(this.$route.params.id)\n    this.loadData()\n  },\n  methods: {\n    async loadData() {\n      this.loading = true\n      try {\n        // 加载活动信息\n        await this.loadActivity()\n        // 先加载签到列表\n        await this.loadSigns()\n        // 再加载报名列表（需要用到签到列表数据）\n        await this.loadRegistrations()\n        // 加载评价列表\n        await this.loadEvaluations()\n      } catch (error) {\n        console.error('加载数据失败:', error)\n      } finally {\n        this.loading = false\n      }\n    },\n    async loadActivity() {\n      const res = await activityApi.getActivityById(this.activityId)\n      if (res.code === 200) {\n        this.activity = res.data\n      }\n    },\n    async loadRegistrations() {\n      const res = await registrationApi.getRegistrationByActivity(this.activityId)\n      if (res.code === 200) {\n        this.registrationList = res.data || []\n        this.registrationCount = this.registrationList.length\n        \n        // 为每个报名记录添加是否签到的标识，使用$set确保响应式\n        this.registrationList.forEach(reg => {\n          const hasSigned = this.signList.some(sign => \n            sign.userId != null && reg.userId != null && \n            Number(sign.userId) === Number(reg.userId)\n          )\n          this.$set(reg, 'hasSigned', hasSigned)\n        })\n      }\n    },\n    async loadSigns() {\n      const res = await signScoreApi.getSignListByActivity(this.activityId)\n      if (res.code === 200) {\n        this.signList = res.data || []\n        this.signCount = this.signList.length\n      }\n    },\n    async loadEvaluations() {\n      const res = await evaluationApi.getEvaluationList(this.activityId)\n      if (res.code === 200) {\n        this.evaluationList = res.data || []\n      }\n    },\n    goBack() {\n      this.$router.go(-1)\n    },\n    getStatusType(status) {\n      const map = {\n        '待审': 'warning',\n        '通过': 'success',\n        '拒绝': 'danger'\n      }\n      return map[status] || 'info'\n    },\n    formatDateTime(dateStr) {\n      if (!dateStr) return ''\n      const date = new Date(dateStr)\n      return date.toLocaleString('zh-CN')\n    }\n  }\n}\n</script>\n\n<style scoped>\n.activity-detail {\n  padding: 20px;\n}\n\n.detail-section {\n  margin-bottom: 30px;\n}\n\n.detail-section h3 {\n  margin-bottom: 15px;\n  color: #303133;\n  border-left: 4px solid #409EFF;\n  padding-left: 10px;\n}\n\n.stat-card {\n  text-align: center;\n  padding: 20px;\n}\n\n.stat-label {\n  font-size: 14px;\n  color: #909399;\n  margin-bottom: 10px;\n}\n\n.stat-value {\n  font-size: 32px;\n  font-weight: bold;\n  color: #409EFF;\n}\n</style>\n"],"mappings":"AAkIA,SAAAA,WAAA,EAAAC,eAAA,EAAAC,YAAA,EAAAC,aAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,UAAA;MACAC,QAAA;MACAC,gBAAA;MACAC,QAAA;MACAC,cAAA;MACAC,iBAAA;MACAC,SAAA;MACAC,OAAA;IACA;EACA;EACAC,QAAA;IACAC,SAAA;MACA,SAAAJ,iBAAA;MACA,aAAAC,SAAA,QAAAD,iBAAA,QAAAK,OAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAX,UAAA,GAAAY,QAAA,MAAAC,MAAA,CAAAC,MAAA,CAAAC,EAAA;IACA,KAAAC,QAAA;EACA;EACAC,OAAA;IACA,MAAAD,SAAA;MACA,KAAAT,OAAA;MACA;QACA;QACA,WAAAW,YAAA;QACA;QACA,WAAAC,SAAA;QACA;QACA,WAAAC,iBAAA;QACA;QACA,WAAAC,eAAA;MACA,SAAAC,KAAA;QACAC,OAAA,CAAAD,KAAA,YAAAA,KAAA;MACA;QACA,KAAAf,OAAA;MACA;IACA;IACA,MAAAW,aAAA;MACA,MAAAM,GAAA,SAAA9B,WAAA,CAAA+B,eAAA,MAAAzB,UAAA;MACA,IAAAwB,GAAA,CAAAE,IAAA;QACA,KAAAzB,QAAA,GAAAuB,GAAA,CAAAzB,IAAA;MACA;IACA;IACA,MAAAqB,kBAAA;MACA,MAAAI,GAAA,SAAA7B,eAAA,CAAAgC,yBAAA,MAAA3B,UAAA;MACA,IAAAwB,GAAA,CAAAE,IAAA;QACA,KAAAxB,gBAAA,GAAAsB,GAAA,CAAAzB,IAAA;QACA,KAAAM,iBAAA,QAAAH,gBAAA,CAAA0B,MAAA;;QAEA;QACA,KAAA1B,gBAAA,CAAA2B,OAAA,CAAAC,GAAA;UACA,MAAAC,SAAA,QAAA5B,QAAA,CAAA6B,IAAA,CAAAC,IAAA,IACAA,IAAA,CAAAC,MAAA,YAAAJ,GAAA,CAAAI,MAAA,YACAC,MAAA,CAAAF,IAAA,CAAAC,MAAA,MAAAC,MAAA,CAAAL,GAAA,CAAAI,MAAA,CACA;UACA,KAAAE,IAAA,CAAAN,GAAA,eAAAC,SAAA;QACA;MACA;IACA;IACA,MAAAZ,UAAA;MACA,MAAAK,GAAA,SAAA5B,YAAA,CAAAyC,qBAAA,MAAArC,UAAA;MACA,IAAAwB,GAAA,CAAAE,IAAA;QACA,KAAAvB,QAAA,GAAAqB,GAAA,CAAAzB,IAAA;QACA,KAAAO,SAAA,QAAAH,QAAA,CAAAyB,MAAA;MACA;IACA;IACA,MAAAP,gBAAA;MACA,MAAAG,GAAA,SAAA3B,aAAA,CAAAyC,iBAAA,MAAAtC,UAAA;MACA,IAAAwB,GAAA,CAAAE,IAAA;QACA,KAAAtB,cAAA,GAAAoB,GAAA,CAAAzB,IAAA;MACA;IACA;IACAwC,OAAA;MACA,KAAAC,OAAA,CAAAC,EAAA;IACA;IACAC,cAAAC,MAAA;MACA,MAAAC,GAAA;QACA;QACA;QACA;MACA;MACA,OAAAA,GAAA,CAAAD,MAAA;IACA;IACAE,eAAAC,OAAA;MACA,KAAAA,OAAA;MACA,MAAAC,IAAA,OAAAC,IAAA,CAAAF,OAAA;MACA,OAAAC,IAAA,CAAAE,cAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}