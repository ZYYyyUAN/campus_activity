{"ast":null,"code":"import { logApi } from '@/api';\nexport default {\n  name: 'LogList',\n  data() {\n    return {\n      logList: [],\n      loading: false,\n      searchForm: {\n        operationType: '',\n        startTime: '',\n        endTime: ''\n      },\n      currentPage: 1,\n      pageSize: 10,\n      total: 0\n    };\n  },\n  mounted() {\n    this.loadLogList();\n  },\n  methods: {\n    async loadLogList() {\n      this.loading = true;\n      try {\n        const params = {\n          ...this.searchForm,\n          page: this.currentPage,\n          size: this.pageSize\n        };\n        // 移除空值参数\n        Object.keys(params).forEach(key => {\n          if (!params[key]) {\n            delete params[key];\n          }\n        });\n        const res = await logApi.queryLog(params);\n        if (res.code === 200) {\n          this.logList = res.data || [];\n          this.total = this.logList.length;\n        }\n      } catch (error) {\n        console.error('加载日志列表失败:', error);\n      } finally {\n        this.loading = false;\n      }\n    },\n    handleSearch() {\n      this.currentPage = 1;\n      this.loadLogList();\n    },\n    handleReset() {\n      this.searchForm = {\n        operationType: '',\n        startTime: '',\n        endTime: ''\n      };\n      this.currentPage = 1;\n      this.loadLogList();\n    },\n    handleDelete(row) {\n      this.$confirm(`确定要删除这条日志吗?`, '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(async () => {\n        try {\n          const res = await logApi.deleteLog(row.logId);\n          if (res.code === 200) {\n            this.$message.success('删除成功');\n            this.loadLogList();\n          }\n        } catch (error) {\n          console.error('删除失败:', error);\n        }\n      });\n    },\n    handleSizeChange(val) {\n      this.pageSize = val;\n      this.loadLogList();\n    },\n    handleCurrentChange(val) {\n      this.currentPage = val;\n      this.loadLogList();\n    },\n    getOperationTypeColor(type) {\n      const colorMap = {\n        '发布活动': 'success',\n        '删除活动': 'danger',\n        '审核通过': 'warning'\n      };\n      return colorMap[type] || 'info';\n    },\n    formatDateTime(dateStr) {\n      if (!dateStr) return '';\n      const date = new Date(dateStr);\n      return date.toLocaleString('zh-CN');\n    }\n  }\n};","map":{"version":3,"names":["logApi","name","data","logList","loading","searchForm","operationType","startTime","endTime","currentPage","pageSize","total","mounted","loadLogList","methods","params","page","size","Object","keys","forEach","key","res","queryLog","code","length","error","console","handleSearch","handleReset","handleDelete","row","$confirm","confirmButtonText","cancelButtonText","type","then","deleteLog","logId","$message","success","handleSizeChange","val","handleCurrentChange","getOperationTypeColor","colorMap","formatDateTime","dateStr","date","Date","toLocaleString"],"sources":["src/views/log/LogList.vue"],"sourcesContent":["<template>\r\n  <div class=\"log-list\">\r\n    <el-card>\r\n      <div slot=\"header\">\r\n        <span>系统日志</span>\r\n      </div>\r\n      \r\n      <!-- 搜索栏 -->\r\n      <el-form :inline=\"true\" :model=\"searchForm\" class=\"search-form\">\r\n        <el-form-item label=\"操作类型\">\r\n          <el-select v-model=\"searchForm.operationType\" placeholder=\"请选择\" clearable>\r\n            <el-option label=\"发布活动\" value=\"发布活动\"></el-option>\r\n            <el-option label=\"删除活动\" value=\"删除活动\"></el-option>\r\n            <el-option label=\"审核通过\" value=\"审核通过\"></el-option>\r\n          </el-select>\r\n        </el-form-item>\r\n        <el-form-item label=\"开始时间\">\r\n          <el-date-picker\r\n            v-model=\"searchForm.startTime\"\r\n            type=\"datetime\"\r\n            placeholder=\"选择开始时间\"\r\n            format=\"yyyy-MM-dd HH:mm:ss\"\r\n            value-format=\"yyyy-MM-dd HH:mm:ss\"\r\n          ></el-date-picker>\r\n        </el-form-item>\r\n        <el-form-item label=\"结束时间\">\r\n          <el-date-picker\r\n            v-model=\"searchForm.endTime\"\r\n            type=\"datetime\"\r\n            placeholder=\"选择结束时间\"\r\n            format=\"yyyy-MM-dd HH:mm:ss\"\r\n            value-format=\"yyyy-MM-dd HH:mm:ss\"\r\n          ></el-date-picker>\r\n        </el-form-item>\r\n        <el-form-item>\r\n          <el-button type=\"primary\" icon=\"el-icon-search\" @click=\"handleSearch\">查询</el-button>\r\n          <el-button icon=\"el-icon-refresh\" @click=\"handleReset\">重置</el-button>\r\n        </el-form-item>\r\n      </el-form>\r\n      \r\n      <!-- 日志表格 -->\r\n      <el-table :data=\"logList\" border style=\"width: 100%\" v-loading=\"loading\">\r\n        <el-table-column prop=\"logId\" label=\"日志ID\" width=\"80\"></el-table-column>\r\n        <el-table-column prop=\"realName\" label=\"操作用户\" width=\"120\"></el-table-column>\r\n        <el-table-column prop=\"operationType\" label=\"操作类型\" width=\"120\">\r\n          <template slot-scope=\"scope\">\r\n            <el-tag :type=\"getOperationTypeColor(scope.row.operationType)\">\r\n              {{ scope.row.operationType }}\r\n            </el-tag>\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column prop=\"operationContent\" label=\"操作内容\" min-width=\"200\"></el-table-column>\r\n        <el-table-column prop=\"operationTime\" label=\"操作时间\" width=\"180\">\r\n          <template slot-scope=\"scope\">\r\n            {{ formatDateTime(scope.row.operationTime) }}\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column label=\"操作\" width=\"100\" fixed=\"right\">\r\n          <template slot-scope=\"scope\">\r\n            <el-button size=\"mini\" type=\"danger\" @click=\"handleDelete(scope.row)\">删除</el-button>\r\n          </template>\r\n        </el-table-column>\r\n      </el-table>\r\n      \r\n      <!-- 分页 -->\r\n      <div class=\"pagination\">\r\n        <el-pagination\r\n          @size-change=\"handleSizeChange\"\r\n          @current-change=\"handleCurrentChange\"\r\n          :current-page=\"currentPage\"\r\n          :page-sizes=\"[10, 20, 50, 100]\"\r\n          :page-size=\"pageSize\"\r\n          layout=\"total, sizes, prev, pager, next, jumper\"\r\n          :total=\"total\">\r\n        </el-pagination>\r\n      </div>\r\n    </el-card>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { logApi } from '@/api'\r\n\r\nexport default {\r\n  name: 'LogList',\r\n  data() {\r\n    return {\r\n      logList: [],\r\n      loading: false,\r\n      searchForm: {\r\n        operationType: '',\r\n        startTime: '',\r\n        endTime: ''\r\n      },\r\n      currentPage: 1,\r\n      pageSize: 10,\r\n      total: 0\r\n    }\r\n  },\r\n  mounted() {\r\n    this.loadLogList()\r\n  },\r\n  methods: {\r\n    async loadLogList() {\r\n      this.loading = true\r\n      try {\r\n        const params = {\r\n          ...this.searchForm,\r\n          page: this.currentPage,\r\n          size: this.pageSize\r\n        }\r\n        // 移除空值参数\r\n        Object.keys(params).forEach(key => {\r\n          if (!params[key]) {\r\n            delete params[key]\r\n          }\r\n        })\r\n        const res = await logApi.queryLog(params)\r\n        if (res.code === 200) {\r\n          this.logList = res.data || []\r\n          this.total = this.logList.length\r\n        }\r\n      } catch (error) {\r\n        console.error('加载日志列表失败:', error)\r\n      } finally {\r\n        this.loading = false\r\n      }\r\n    },\r\n    handleSearch() {\r\n      this.currentPage = 1\r\n      this.loadLogList()\r\n    },\r\n    handleReset() {\r\n      this.searchForm = {\r\n        operationType: '',\r\n        startTime: '',\r\n        endTime: ''\r\n      }\r\n      this.currentPage = 1\r\n      this.loadLogList()\r\n    },\r\n    handleDelete(row) {\r\n      this.$confirm(`确定要删除这条日志吗?`, '提示', {\r\n        confirmButtonText: '确定',\r\n        cancelButtonText: '取消',\r\n        type: 'warning'\r\n      }).then(async () => {\r\n        try {\r\n          const res = await logApi.deleteLog(row.logId)\r\n          if (res.code === 200) {\r\n            this.$message.success('删除成功')\r\n            this.loadLogList()\r\n          }\r\n        } catch (error) {\r\n          console.error('删除失败:', error)\r\n        }\r\n      })\r\n    },\r\n    handleSizeChange(val) {\r\n      this.pageSize = val\r\n      this.loadLogList()\r\n    },\r\n    handleCurrentChange(val) {\r\n      this.currentPage = val\r\n      this.loadLogList()\r\n    },\r\n    getOperationTypeColor(type) {\r\n      const colorMap = {\r\n        '发布活动': 'success',\r\n        '删除活动': 'danger',\r\n        '审核通过': 'warning'\r\n      }\r\n      return colorMap[type] || 'info'\r\n    },\r\n    formatDateTime(dateStr) {\r\n      if (!dateStr) return ''\r\n      const date = new Date(dateStr)\r\n      return date.toLocaleString('zh-CN')\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.log-list {\r\n  padding: 20px;\r\n}\r\n\r\n.search-form {\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.pagination {\r\n  margin-top: 20px;\r\n  text-align: right;\r\n}\r\n</style>\r\n\r\n"],"mappings":"AAiFA,SAAAA,MAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,OAAA;MACAC,OAAA;MACAC,UAAA;QACAC,aAAA;QACAC,SAAA;QACAC,OAAA;MACA;MACAC,WAAA;MACAC,QAAA;MACAC,KAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,WAAA;EACA;EACAC,OAAA;IACA,MAAAD,YAAA;MACA,KAAAT,OAAA;MACA;QACA,MAAAW,MAAA;UACA,QAAAV,UAAA;UACAW,IAAA,OAAAP,WAAA;UACAQ,IAAA,OAAAP;QACA;QACA;QACAQ,MAAA,CAAAC,IAAA,CAAAJ,MAAA,EAAAK,OAAA,CAAAC,GAAA;UACA,KAAAN,MAAA,CAAAM,GAAA;YACA,OAAAN,MAAA,CAAAM,GAAA;UACA;QACA;QACA,MAAAC,GAAA,SAAAtB,MAAA,CAAAuB,QAAA,CAAAR,MAAA;QACA,IAAAO,GAAA,CAAAE,IAAA;UACA,KAAArB,OAAA,GAAAmB,GAAA,CAAApB,IAAA;UACA,KAAAS,KAAA,QAAAR,OAAA,CAAAsB,MAAA;QACA;MACA,SAAAC,KAAA;QACAC,OAAA,CAAAD,KAAA,cAAAA,KAAA;MACA;QACA,KAAAtB,OAAA;MACA;IACA;IACAwB,aAAA;MACA,KAAAnB,WAAA;MACA,KAAAI,WAAA;IACA;IACAgB,YAAA;MACA,KAAAxB,UAAA;QACAC,aAAA;QACAC,SAAA;QACAC,OAAA;MACA;MACA,KAAAC,WAAA;MACA,KAAAI,WAAA;IACA;IACAiB,aAAAC,GAAA;MACA,KAAAC,QAAA;QACAC,iBAAA;QACAC,gBAAA;QACAC,IAAA;MACA,GAAAC,IAAA;QACA;UACA,MAAAd,GAAA,SAAAtB,MAAA,CAAAqC,SAAA,CAAAN,GAAA,CAAAO,KAAA;UACA,IAAAhB,GAAA,CAAAE,IAAA;YACA,KAAAe,QAAA,CAAAC,OAAA;YACA,KAAA3B,WAAA;UACA;QACA,SAAAa,KAAA;UACAC,OAAA,CAAAD,KAAA,UAAAA,KAAA;QACA;MACA;IACA;IACAe,iBAAAC,GAAA;MACA,KAAAhC,QAAA,GAAAgC,GAAA;MACA,KAAA7B,WAAA;IACA;IACA8B,oBAAAD,GAAA;MACA,KAAAjC,WAAA,GAAAiC,GAAA;MACA,KAAA7B,WAAA;IACA;IACA+B,sBAAAT,IAAA;MACA,MAAAU,QAAA;QACA;QACA;QACA;MACA;MACA,OAAAA,QAAA,CAAAV,IAAA;IACA;IACAW,eAAAC,OAAA;MACA,KAAAA,OAAA;MACA,MAAAC,IAAA,OAAAC,IAAA,CAAAF,OAAA;MACA,OAAAC,IAAA,CAAAE,cAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}