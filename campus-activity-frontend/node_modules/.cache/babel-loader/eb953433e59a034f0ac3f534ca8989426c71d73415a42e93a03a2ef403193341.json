{"ast":null,"code":"import { activityApi, userApi, logApi, registrationApi, signScoreApi } from '@/api';\nexport default {\n  name: 'DashboardPage',\n  data() {\n    return {\n      activityCount: 0,\n      userCount: 0,\n      logCount: 0\n    };\n  },\n  computed: {\n    isAdmin() {\n      return this.$store.getters.isAdmin;\n    },\n    isPublisher() {\n      return this.$store.getters.isPublisher;\n    },\n    isStudent() {\n      return this.$store.getters.isStudent;\n    }\n  },\n  mounted() {\n    this.loadStatistics();\n  },\n  methods: {\n    async loadStatistics() {\n      try {\n        if (this.isAdmin) {\n          // 管理员显示全部统计\n          const [activityRes, userRes, logRes] = await Promise.all([activityApi.getActivityList(), userApi.getUserList(), logApi.getLogList()]);\n          if (activityRes.code === 200) {\n            this.activityCount = activityRes.data ? activityRes.data.length : 0;\n          }\n          if (userRes.code === 200) {\n            this.userCount = userRes.data ? userRes.data.length : 0;\n          }\n          if (logRes.code === 200) {\n            this.logCount = logRes.data ? logRes.data.length : 0;\n          }\n        } else if (this.isPublisher) {\n          // 发布者显示自己发布的活动统计\n          const publisherId = this.$store.state.user.userId;\n          const res = await activityApi.getActivityByPublisher(publisherId);\n          if (res.code === 200) {\n            this.activityCount = res.data ? res.data.length : 0;\n          }\n        } else if (this.isStudent) {\n          // 学生显示自己的报名和积分统计\n          const userId = this.$store.state.user.userId;\n          // 这里需要调用学生相关的API\n          this.activityCount = 0;\n        }\n      } catch (error) {\n        console.error('加载统计信息失败:', error);\n      }\n    }\n  }\n};","map":{"version":3,"names":["activityApi","userApi","logApi","registrationApi","signScoreApi","name","data","activityCount","userCount","logCount","computed","isAdmin","$store","getters","isPublisher","isStudent","mounted","loadStatistics","methods","activityRes","userRes","logRes","Promise","all","getActivityList","getUserList","getLogList","code","length","publisherId","state","user","userId","res","getActivityByPublisher","error","console"],"sources":["src/views/Dashboard.vue"],"sourcesContent":["<template>\n  <div class=\"dashboard\">\n    <el-row :gutter=\"20\">\n      <el-col :span=\"6\">\n        <el-card class=\"box-card\">\n          <div class=\"card-content\">\n            <div class=\"card-icon\" style=\"background: #409EFF;\">\n              <i class=\"el-icon-tickets\"></i>\n            </div>\n            <div class=\"card-info\">\n              <div class=\"card-value\">{{ activityCount }}</div>\n              <div class=\"card-label\">活动总数</div>\n            </div>\n          </div>\n        </el-card>\n      </el-col>\n      <el-col :span=\"6\">\n        <el-card class=\"box-card\">\n          <div class=\"card-content\">\n            <div class=\"card-icon\" style=\"background: #67C23A;\">\n              <i class=\"el-icon-user\"></i>\n            </div>\n            <div class=\"card-info\">\n              <div class=\"card-value\">{{ userCount }}</div>\n              <div class=\"card-label\">用户总数</div>\n            </div>\n          </div>\n        </el-card>\n      </el-col>\n      <el-col :span=\"6\">\n        <el-card class=\"box-card\">\n          <div class=\"card-content\">\n            <div class=\"card-icon\" style=\"background: #E6A23C;\">\n              <i class=\"el-icon-edit-outline\"></i>\n            </div>\n            <div class=\"card-info\">\n              <div class=\"card-value\">{{ logCount }}</div>\n              <div class=\"card-label\">操作日志</div>\n            </div>\n          </div>\n        </el-card>\n      </el-col>\n      <el-col :span=\"6\">\n        <el-card class=\"box-card\">\n          <div class=\"card-content\">\n            <div class=\"card-icon\" style=\"background: #F56C6C;\">\n              <i class=\"el-icon-warning\"></i>\n            </div>\n            <div class=\"card-info\">\n              <div class=\"card-value\">系统运行中</div>\n              <div class=\"card-label\">系统状态</div>\n            </div>\n          </div>\n        </el-card>\n      </el-col>\n    </el-row>\n  </div>\n</template>\n\n<script>\nimport { activityApi, userApi, logApi, registrationApi, signScoreApi } from '@/api'\n\nexport default {\n  name: 'DashboardPage',\n  data() {\n    return {\n      activityCount: 0,\n      userCount: 0,\n      logCount: 0\n    }\n  },\n  computed: {\n    isAdmin() {\n      return this.$store.getters.isAdmin\n    },\n    isPublisher() {\n      return this.$store.getters.isPublisher\n    },\n    isStudent() {\n      return this.$store.getters.isStudent\n    }\n  },\n  mounted() {\n    this.loadStatistics()\n  },\n  methods: {\n    async loadStatistics() {\n      try {\n        if (this.isAdmin) {\n          // 管理员显示全部统计\n          const [activityRes, userRes, logRes] = await Promise.all([\n            activityApi.getActivityList(),\n            userApi.getUserList(),\n            logApi.getLogList()\n          ])\n          if (activityRes.code === 200) {\n            this.activityCount = activityRes.data ? activityRes.data.length : 0\n          }\n          if (userRes.code === 200) {\n            this.userCount = userRes.data ? userRes.data.length : 0\n          }\n          if (logRes.code === 200) {\n            this.logCount = logRes.data ? logRes.data.length : 0\n          }\n        } else if (this.isPublisher) {\n          // 发布者显示自己发布的活动统计\n          const publisherId = this.$store.state.user.userId\n          const res = await activityApi.getActivityByPublisher(publisherId)\n          if (res.code === 200) {\n            this.activityCount = res.data ? res.data.length : 0\n          }\n        } else if (this.isStudent) {\n          // 学生显示自己的报名和积分统计\n          const userId = this.$store.state.user.userId\n          // 这里需要调用学生相关的API\n          this.activityCount = 0\n        }\n      } catch (error) {\n        console.error('加载统计信息失败:', error)\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n.dashboard {\n  padding: 20px;\n}\n\n.box-card {\n  margin-bottom: 20px;\n}\n\n.card-content {\n  display: flex;\n  align-items: center;\n}\n\n.card-icon {\n  width: 60px;\n  height: 60px;\n  border-radius: 8px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: white;\n  font-size: 30px;\n  margin-right: 15px;\n}\n\n.card-info {\n  flex: 1;\n}\n\n.card-value {\n  font-size: 28px;\n  font-weight: bold;\n  color: #303133;\n  margin-bottom: 5px;\n}\n\n.card-label {\n  font-size: 14px;\n  color: #909399;\n}\n</style>\n\n"],"mappings":"AA4DA,SAAAA,WAAA,EAAAC,OAAA,EAAAC,MAAA,EAAAC,eAAA,EAAAC,YAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,aAAA;MACAC,SAAA;MACAC,QAAA;IACA;EACA;EACAC,QAAA;IACAC,QAAA;MACA,YAAAC,MAAA,CAAAC,OAAA,CAAAF,OAAA;IACA;IACAG,YAAA;MACA,YAAAF,MAAA,CAAAC,OAAA,CAAAC,WAAA;IACA;IACAC,UAAA;MACA,YAAAH,MAAA,CAAAC,OAAA,CAAAE,SAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,cAAA;EACA;EACAC,OAAA;IACA,MAAAD,eAAA;MACA;QACA,SAAAN,OAAA;UACA;UACA,OAAAQ,WAAA,EAAAC,OAAA,EAAAC,MAAA,UAAAC,OAAA,CAAAC,GAAA,EACAvB,WAAA,CAAAwB,eAAA,IACAvB,OAAA,CAAAwB,WAAA,IACAvB,MAAA,CAAAwB,UAAA,GACA;UACA,IAAAP,WAAA,CAAAQ,IAAA;YACA,KAAApB,aAAA,GAAAY,WAAA,CAAAb,IAAA,GAAAa,WAAA,CAAAb,IAAA,CAAAsB,MAAA;UACA;UACA,IAAAR,OAAA,CAAAO,IAAA;YACA,KAAAnB,SAAA,GAAAY,OAAA,CAAAd,IAAA,GAAAc,OAAA,CAAAd,IAAA,CAAAsB,MAAA;UACA;UACA,IAAAP,MAAA,CAAAM,IAAA;YACA,KAAAlB,QAAA,GAAAY,MAAA,CAAAf,IAAA,GAAAe,MAAA,CAAAf,IAAA,CAAAsB,MAAA;UACA;QACA,gBAAAd,WAAA;UACA;UACA,MAAAe,WAAA,QAAAjB,MAAA,CAAAkB,KAAA,CAAAC,IAAA,CAAAC,MAAA;UACA,MAAAC,GAAA,SAAAjC,WAAA,CAAAkC,sBAAA,CAAAL,WAAA;UACA,IAAAI,GAAA,CAAAN,IAAA;YACA,KAAApB,aAAA,GAAA0B,GAAA,CAAA3B,IAAA,GAAA2B,GAAA,CAAA3B,IAAA,CAAAsB,MAAA;UACA;QACA,gBAAAb,SAAA;UACA;UACA,MAAAiB,MAAA,QAAApB,MAAA,CAAAkB,KAAA,CAAAC,IAAA,CAAAC,MAAA;UACA;UACA,KAAAzB,aAAA;QACA;MACA,SAAA4B,KAAA;QACAC,OAAA,CAAAD,KAAA,cAAAA,KAAA;MACA;IACA;EACA;AACA","ignoreList"