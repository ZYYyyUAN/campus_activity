{"ast":null,"code":"import { activityApi, registrationApi, signScoreApi, evaluationApi } from '@/api';\nexport default {\n  name: 'ActivityDetail',\n  data() {\n    return {\n      activityId: null,\n      activity: null,\n      registrationList: [],\n      signList: [],\n      evaluationList: [],\n      registrationCount: 0,\n      signCount: 0,\n      loading: false\n    };\n  },\n  computed: {\n    signRate() {\n      if (this.registrationCount === 0) return 0;\n      return (this.signCount / this.registrationCount * 100).toFixed(1);\n    }\n  },\n  mounted() {\n    this.activityId = parseInt(this.$route.params.id);\n    this.loadData();\n  },\n  methods: {\n    async loadData() {\n      this.loading = true;\n      try {\n        // 加载活动信息\n        await this.loadActivity();\n        // 加载报名列表\n        await this.loadRegistrations();\n        // 加载签到列表\n        await this.loadSigns();\n        // 加载评价列表\n        await this.loadEvaluations();\n      } catch (error) {\n        console.error('加载数据失败:', error);\n      } finally {\n        this.loading = false;\n      }\n    },\n    async loadActivity() {\n      const res = await activityApi.getActivityById(this.activityId);\n      if (res.code === 200) {\n        this.activity = res.data;\n      }\n    },\n    async loadRegistrations() {\n      const res = await registrationApi.getRegistrationByActivity(this.activityId);\n      if (res.code === 200) {\n        this.registrationList = res.data || [];\n        this.registrationCount = this.registrationList.length;\n\n        // 为每个报名记录添加是否签到的标识\n        this.registrationList.forEach(reg => {\n          reg.hasSigned = this.signList.some(sign => sign.userId === reg.userId);\n        });\n      }\n    },\n    async loadSigns() {\n      const res = await signScoreApi.getSignListByActivity(this.activityId);\n      if (res.code === 200) {\n        this.signList = res.data || [];\n        this.signCount = this.signList.length;\n      }\n    },\n    async loadEvaluations() {\n      const res = await evaluationApi.getEvaluationList(this.activityId);\n      if (res.code === 200) {\n        this.evaluationList = res.data || [];\n      }\n    },\n    goBack() {\n      this.$router.go(-1);\n    },\n    getStatusType(status) {\n      const map = {\n        '待审': 'warning',\n        '通过': 'success',\n        '拒绝': 'danger'\n      };\n      return map[status] || 'info';\n    },\n    formatDateTime(dateStr) {\n      if (!dateStr) return '';\n      const date = new Date(dateStr);\n      return date.toLocaleString('zh-CN');\n    }\n  }\n};","map":{"version":3,"names":["activityApi","registrationApi","signScoreApi","evaluationApi","name","data","activityId","activity","registrationList","signList","evaluationList","registrationCount","signCount","loading","computed","signRate","toFixed","mounted","parseInt","$route","params","id","loadData","methods","loadActivity","loadRegistrations","loadSigns","loadEvaluations","error","console","res","getActivityById","code","getRegistrationByActivity","length","forEach","reg","hasSigned","some","sign","userId","getSignListByActivity","getEvaluationList","goBack","$router","go","getStatusType","status","map","formatDateTime","dateStr","date","Date","toLocaleString"],"sources":["src/views/activity/ActivityDetail.vue"],"sourcesContent":["<template>\r\n  <div class=\"activity-detail\">\r\n    <el-card>\r\n      <div slot=\"header\">\r\n        <el-page-header @back=\"goBack\" content=\"活动详情\"></el-page-header>\r\n      </div>\r\n\r\n      <!-- 活动基本信息 -->\r\n      <div v-if=\"activity\" class=\"detail-section\">\r\n        <h3>活动信息</h3>\r\n        <el-descriptions :column=\"2\" border>\r\n          <el-descriptions-item label=\"活动名称\">{{ activity.activityName }}</el-descriptions-item>\r\n          <el-descriptions-item label=\"活动类型\">{{ activity.activityType }}</el-descriptions-item>\r\n          <el-descriptions-item label=\"活动地点\">{{ activity.location }}</el-descriptions-item>\r\n          <el-descriptions-item label=\"活动状态\">\r\n            <el-tag :type=\"activity.status === '报名中' ? 'success' : 'info'\">\r\n              {{ activity.status }}\r\n            </el-tag>\r\n          </el-descriptions-item>\r\n          <el-descriptions-item label=\"开始时间\">{{ formatDateTime(activity.startTime) }}</el-descriptions-item>\r\n          <el-descriptions-item label=\"结束时间\">{{ formatDateTime(activity.endTime) }}</el-descriptions-item>\r\n          <el-descriptions-item label=\"人数上限\">{{ activity.maxPeople }}</el-descriptions-item>\r\n          <el-descriptions-item label=\"发布者\">{{ activity.publisherName }}</el-descriptions-item>\r\n        </el-descriptions>\r\n      </div>\r\n\r\n      <!-- 参与统计 -->\r\n      <div class=\"detail-section\">\r\n        <h3>参与统计</h3>\r\n        <el-row :gutter=\"20\">\r\n          <el-col :span=\"8\">\r\n            <el-card shadow=\"hover\">\r\n              <div class=\"stat-card\">\r\n                <div class=\"stat-label\">报名人数</div>\r\n                <div class=\"stat-value\">{{ registrationCount }}</div>\r\n              </div>\r\n            </el-card>\r\n          </el-col>\r\n          <el-col :span=\"8\">\r\n            <el-card shadow=\"hover\">\r\n              <div class=\"stat-card\">\r\n                <div class=\"stat-label\">签到人数</div>\r\n                <div class=\"stat-value\">{{ signCount }}</div>\r\n              </div>\r\n            </el-card>\r\n          </el-col>\r\n          <el-col :span=\"8\">\r\n            <el-card shadow=\"hover\">\r\n              <div class=\"stat-card\">\r\n                <div class=\"stat-label\">签到率</div>\r\n                <div class=\"stat-value\">{{ signRate }}%</div>\r\n              </div>\r\n            </el-card>\r\n          </el-col>\r\n        </el-row>\r\n      </div>\r\n\r\n      <!-- 报名列表 -->\r\n      <div class=\"detail-section\">\r\n        <h3>报名列表</h3>\r\n        <el-table :data=\"registrationList\" border v-loading=\"loading\">\r\n          <el-table-column type=\"index\" label=\"序号\" width=\"60\"></el-table-column>\r\n          <el-table-column prop=\"realName\" label=\"学生姓名\" width=\"120\"></el-table-column>\r\n          <el-table-column prop=\"userName\" label=\"学号\" width=\"150\"></el-table-column>\r\n          <el-table-column prop=\"registerTime\" label=\"报名时间\" width=\"180\">\r\n            <template slot-scope=\"scope\">\r\n              {{ formatDateTime(scope.row.registerTime) }}\r\n            </template>\r\n          </el-table-column>\r\n          <el-table-column prop=\"auditStatus\" label=\"审核状态\" width=\"120\">\r\n            <template slot-scope=\"scope\">\r\n              <el-tag :type=\"getStatusType(scope.row.auditStatus)\">\r\n                {{ scope.row.auditStatus }}\r\n              </el-tag>\r\n            </template>\r\n          </el-table-column>\r\n          <el-table-column label=\"是否签到\" width=\"120\">\r\n            <template slot-scope=\"scope\">\r\n              <el-tag :type=\"scope.row.hasSigned ? 'success' : 'info'\">\r\n                {{ scope.row.hasSigned ? '已签到' : '未签到' }}\r\n              </el-tag>\r\n            </template>\r\n          </el-table-column>\r\n        </el-table>\r\n      </div>\r\n\r\n      <!-- 签到列表 -->\r\n      <div class=\"detail-section\">\r\n        <h3>签到记录</h3>\r\n        <el-table :data=\"signList\" border v-loading=\"loading\">\r\n          <el-table-column type=\"index\" label=\"序号\" width=\"60\"></el-table-column>\r\n          <el-table-column prop=\"realName\" label=\"学生姓名\" width=\"120\"></el-table-column>\r\n          <el-table-column prop=\"userName\" label=\"学号\" width=\"150\"></el-table-column>\r\n          <el-table-column prop=\"signTime\" label=\"签到时间\" width=\"180\">\r\n            <template slot-scope=\"scope\">\r\n              {{ formatDateTime(scope.row.signTime) }}\r\n            </template>\r\n          </el-table-column>\r\n          <el-table-column prop=\"score\" label=\"获得积分\" width=\"120\">\r\n            <template slot-scope=\"scope\">\r\n              <el-tag type=\"success\">+{{ scope.row.score }}</el-tag>\r\n            </template>\r\n          </el-table-column>\r\n        </el-table>\r\n      </div>\r\n\r\n      <!-- 评价列表 -->\r\n      <div class=\"detail-section\">\r\n        <h3>活动评价</h3>\r\n        <el-table :data=\"evaluationList\" border v-loading=\"loading\">\r\n          <el-table-column type=\"index\" label=\"序号\" width=\"60\"></el-table-column>\r\n          <el-table-column prop=\"realName\" label=\"学生姓名\" width=\"120\"></el-table-column>\r\n          <el-table-column prop=\"rating\" label=\"评分\" width=\"150\">\r\n            <template slot-scope=\"scope\">\r\n              <el-rate v-model=\"scope.row.rating\" disabled></el-rate>\r\n            </template>\r\n          </el-table-column>\r\n          <el-table-column prop=\"content\" label=\"评价内容\" min-width=\"200\"></el-table-column>\r\n          <el-table-column prop=\"evaluationTime\" label=\"评价时间\" width=\"180\">\r\n            <template slot-scope=\"scope\">\r\n              {{ formatDateTime(scope.row.evaluationTime) }}\r\n            </template>\r\n          </el-table-column>\r\n        </el-table>\r\n      </div>\r\n    </el-card>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { activityApi, registrationApi, signScoreApi, evaluationApi } from '@/api'\r\n\r\nexport default {\r\n  name: 'ActivityDetail',\r\n  data() {\r\n    return {\r\n      activityId: null,\r\n      activity: null,\r\n      registrationList: [],\r\n      signList: [],\r\n      evaluationList: [],\r\n      registrationCount: 0,\r\n      signCount: 0,\r\n      loading: false\r\n    }\r\n  },\r\n  computed: {\r\n    signRate() {\r\n      if (this.registrationCount === 0) return 0\r\n      return ((this.signCount / this.registrationCount) * 100).toFixed(1)\r\n    }\r\n  },\r\n  mounted() {\r\n    this.activityId = parseInt(this.$route.params.id)\r\n    this.loadData()\r\n  },\r\n  methods: {\r\n    async loadData() {\r\n      this.loading = true\r\n      try {\r\n        // 加载活动信息\r\n        await this.loadActivity()\r\n        // 加载报名列表\r\n        await this.loadRegistrations()\r\n        // 加载签到列表\r\n        await this.loadSigns()\r\n        // 加载评价列表\r\n        await this.loadEvaluations()\r\n      } catch (error) {\r\n        console.error('加载数据失败:', error)\r\n      } finally {\r\n        this.loading = false\r\n      }\r\n    },\r\n    async loadActivity() {\r\n      const res = await activityApi.getActivityById(this.activityId)\r\n      if (res.code === 200) {\r\n        this.activity = res.data\r\n      }\r\n    },\r\n    async loadRegistrations() {\r\n      const res = await registrationApi.getRegistrationByActivity(this.activityId)\r\n      if (res.code === 200) {\r\n        this.registrationList = res.data || []\r\n        this.registrationCount = this.registrationList.length\r\n        \r\n        // 为每个报名记录添加是否签到的标识\r\n        this.registrationList.forEach(reg => {\r\n          reg.hasSigned = this.signList.some(sign => sign.userId === reg.userId)\r\n        })\r\n      }\r\n    },\r\n    async loadSigns() {\r\n      const res = await signScoreApi.getSignListByActivity(this.activityId)\r\n      if (res.code === 200) {\r\n        this.signList = res.data || []\r\n        this.signCount = this.signList.length\r\n      }\r\n    },\r\n    async loadEvaluations() {\r\n      const res = await evaluationApi.getEvaluationList(this.activityId)\r\n      if (res.code === 200) {\r\n        this.evaluationList = res.data || []\r\n      }\r\n    },\r\n    goBack() {\r\n      this.$router.go(-1)\r\n    },\r\n    getStatusType(status) {\r\n      const map = {\r\n        '待审': 'warning',\r\n        '通过': 'success',\r\n        '拒绝': 'danger'\r\n      }\r\n      return map[status] || 'info'\r\n    },\r\n    formatDateTime(dateStr) {\r\n      if (!dateStr) return ''\r\n      const date = new Date(dateStr)\r\n      return date.toLocaleString('zh-CN')\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.activity-detail {\r\n  padding: 20px;\r\n}\r\n\r\n.detail-section {\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.detail-section h3 {\r\n  margin-bottom: 15px;\r\n  color: #303133;\r\n  border-left: 4px solid #409EFF;\r\n  padding-left: 10px;\r\n}\r\n\r\n.stat-card {\r\n  text-align: center;\r\n  padding: 20px;\r\n}\r\n\r\n.stat-label {\r\n  font-size: 14px;\r\n  color: #909399;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.stat-value {\r\n  font-size: 32px;\r\n  font-weight: bold;\r\n  color: #409EFF;\r\n}\r\n</style>\r\n"],"mappings":"AAkIA,SAAAA,WAAA,EAAAC,eAAA,EAAAC,YAAA,EAAAC,aAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,UAAA;MACAC,QAAA;MACAC,gBAAA;MACAC,QAAA;MACAC,cAAA;MACAC,iBAAA;MACAC,SAAA;MACAC,OAAA;IACA;EACA;EACAC,QAAA;IACAC,SAAA;MACA,SAAAJ,iBAAA;MACA,aAAAC,SAAA,QAAAD,iBAAA,QAAAK,OAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAX,UAAA,GAAAY,QAAA,MAAAC,MAAA,CAAAC,MAAA,CAAAC,EAAA;IACA,KAAAC,QAAA;EACA;EACAC,OAAA;IACA,MAAAD,SAAA;MACA,KAAAT,OAAA;MACA;QACA;QACA,WAAAW,YAAA;QACA;QACA,WAAAC,iBAAA;QACA;QACA,WAAAC,SAAA;QACA;QACA,WAAAC,eAAA;MACA,SAAAC,KAAA;QACAC,OAAA,CAAAD,KAAA,YAAAA,KAAA;MACA;QACA,KAAAf,OAAA;MACA;IACA;IACA,MAAAW,aAAA;MACA,MAAAM,GAAA,SAAA9B,WAAA,CAAA+B,eAAA,MAAAzB,UAAA;MACA,IAAAwB,GAAA,CAAAE,IAAA;QACA,KAAAzB,QAAA,GAAAuB,GAAA,CAAAzB,IAAA;MACA;IACA;IACA,MAAAoB,kBAAA;MACA,MAAAK,GAAA,SAAA7B,eAAA,CAAAgC,yBAAA,MAAA3B,UAAA;MACA,IAAAwB,GAAA,CAAAE,IAAA;QACA,KAAAxB,gBAAA,GAAAsB,GAAA,CAAAzB,IAAA;QACA,KAAAM,iBAAA,QAAAH,gBAAA,CAAA0B,MAAA;;QAEA;QACA,KAAA1B,gBAAA,CAAA2B,OAAA,CAAAC,GAAA;UACAA,GAAA,CAAAC,SAAA,QAAA5B,QAAA,CAAA6B,IAAA,CAAAC,IAAA,IAAAA,IAAA,CAAAC,MAAA,KAAAJ,GAAA,CAAAI,MAAA;QACA;MACA;IACA;IACA,MAAAd,UAAA;MACA,MAAAI,GAAA,SAAA5B,YAAA,CAAAuC,qBAAA,MAAAnC,UAAA;MACA,IAAAwB,GAAA,CAAAE,IAAA;QACA,KAAAvB,QAAA,GAAAqB,GAAA,CAAAzB,IAAA;QACA,KAAAO,SAAA,QAAAH,QAAA,CAAAyB,MAAA;MACA;IACA;IACA,MAAAP,gBAAA;MACA,MAAAG,GAAA,SAAA3B,aAAA,CAAAuC,iBAAA,MAAApC,UAAA;MACA,IAAAwB,GAAA,CAAAE,IAAA;QACA,KAAAtB,cAAA,GAAAoB,GAAA,CAAAzB,IAAA;MACA;IACA;IACAsC,OAAA;MACA,KAAAC,OAAA,CAAAC,EAAA;IACA;IACAC,cAAAC,MAAA;MACA,MAAAC,GAAA;QACA;QACA;QACA;MACA;MACA,OAAAA,GAAA,CAAAD,MAAA;IACA;IACAE,eAAAC,OAAA;MACA,KAAAA,OAAA;MACA,MAAAC,IAAA,OAAAC,IAAA,CAAAF,OAAA;MACA,OAAAC,IAAA,CAAAE,cAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}