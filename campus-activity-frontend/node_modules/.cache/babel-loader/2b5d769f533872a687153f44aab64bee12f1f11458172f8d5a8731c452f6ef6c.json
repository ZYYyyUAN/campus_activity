{"ast":null,"code":"import { activityApi, registrationApi, signScoreApi } from '@/api';\nexport default {\n  name: 'ActivityBrowse',\n  data() {\n    return {\n      activityList: [],\n      loading: false,\n      searchForm: {\n        activityType: '',\n        keyword: ''\n      }\n    };\n  },\n  mounted() {\n    this.loadActivityList();\n  },\n  methods: {\n    async loadActivityList() {\n      this.loading = true;\n      try {\n        const res = await activityApi.getActivityList();\n        if (res.code === 200) {\n          this.activityList = res.data || [];\n        }\n      } catch (error) {\n        console.error('加载活动列表失败:', error);\n      } finally {\n        this.loading = false;\n      }\n    },\n    async handleRegister(row) {\n      try {\n        const res = await registrationApi.registerActivity({\n          activityId: row.activityId,\n          userId: this.$store.state.user.userId\n        });\n        if (res.code === 200) {\n          this.$message.success('报名成功');\n        }\n      } catch (error) {\n        console.error('报名失败:', error);\n      }\n    },\n    async handleSign(row) {\n      try {\n        const res = await signScoreApi.signActivity({\n          activityId: row.activityId,\n          userId: this.$store.state.user.userId,\n          score: 10\n        });\n        if (res.code === 200) {\n          this.$message.success('签到成功，获得10积分');\n        }\n      } catch (error) {\n        console.error('签到失败:', error);\n      }\n    },\n    handleEvaluate(row) {\n      this.$router.push(`/evaluation/${row.activityId}`);\n    },\n    handleSearch() {\n      this.loadActivityList();\n    },\n    handleReset() {\n      this.searchForm = {\n        activityType: '',\n        keyword: ''\n      };\n      this.loadActivityList();\n    },\n    formatDateTime(dateStr) {\n      if (!dateStr) return '';\n      const date = new Date(dateStr);\n      return date.toLocaleString('zh-CN');\n    }\n  }\n};","map":{"version":3,"names":["activityApi","registrationApi","signScoreApi","name","data","activityList","loading","searchForm","activityType","keyword","mounted","loadActivityList","methods","res","getActivityList","code","error","console","handleRegister","row","registerActivity","activityId","userId","$store","state","user","$message","success","handleSign","signActivity","score","handleEvaluate","$router","push","handleSearch","handleReset","formatDateTime","dateStr","date","Date","toLocaleString"],"sources":["src/views/student/ActivityBrowse.vue"],"sourcesContent":["<template>\r\n  <div class=\"activity-browse\">\r\n    <el-card>\r\n      <div slot=\"header\">\r\n        <span>活动浏览</span>\r\n      </div>\r\n      \r\n      <!-- 搜索栏 -->\r\n      <el-form :inline=\"true\" :model=\"searchForm\" class=\"search-form\">\r\n        <el-form-item label=\"活动类型\">\r\n          <el-select v-model=\"searchForm.activityType\" placeholder=\"请选择\" clearable>\r\n            <el-option label=\"讲座\" value=\"讲座\"></el-option>\r\n            <el-option label=\"比赛\" value=\"比赛\"></el-option>\r\n            <el-option label=\"学术论坛\" value=\"学术论坛\"></el-option>\r\n            <el-option label=\"班级活动\" value=\"班级活动\"></el-option>\r\n            <el-option label=\"志愿服务\" value=\"志愿服务\"></el-option>\r\n          </el-select>\r\n        </el-form-item>\r\n        <el-form-item label=\"关键词\">\r\n          <el-input v-model=\"searchForm.keyword\" placeholder=\"活动名称/地点\" clearable></el-input>\r\n        </el-form-item>\r\n        <el-form-item>\r\n          <el-button type=\"primary\" icon=\"el-icon-search\" @click=\"handleSearch\">查询</el-button>\r\n          <el-button icon=\"el-icon-refresh\" @click=\"handleReset\">重置</el-button>\r\n        </el-form-item>\r\n      </el-form>\r\n      \r\n      <!-- 活动表格 -->\r\n      <el-table :data=\"activityList\" border style=\"width: 100%\" v-loading=\"loading\">\r\n        <el-table-column prop=\"activityName\" label=\"活动名称\" min-width=\"150\"></el-table-column>\r\n        <el-table-column prop=\"activityType\" label=\"活动类型\" width=\"120\"></el-table-column>\r\n        <el-table-column prop=\"location\" label=\"活动地点\" width=\"150\"></el-table-column>\r\n        <el-table-column prop=\"startTime\" label=\"开始时间\" width=\"180\">\r\n          <template slot-scope=\"scope\">\r\n            {{ formatDateTime(scope.row.startTime) }}\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column prop=\"maxPeople\" label=\"人数上限\" width=\"100\"></el-table-column>\r\n        <el-table-column prop=\"status\" label=\"状态\" width=\"100\">\r\n          <template slot-scope=\"scope\">\r\n            <el-tag :type=\"scope.row.status === '报名中' ? 'success' : 'info'\">\r\n              {{ scope.row.status }}\r\n            </el-tag>\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column label=\"操作\" width=\"200\" fixed=\"right\">\r\n          <template slot-scope=\"scope\">\r\n            <el-button size=\"mini\" type=\"primary\" @click=\"handleRegister(scope.row)\">报名</el-button>\r\n            <el-button size=\"mini\" @click=\"handleSign(scope.row)\">签到</el-button>\r\n            <el-button size=\"mini\" @click=\"handleEvaluate(scope.row)\">评价</el-button>\r\n          </template>\r\n        </el-table-column>\r\n      </el-table>\r\n    </el-card>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { activityApi, registrationApi, signScoreApi } from '@/api'\r\n\r\nexport default {\r\n  name: 'ActivityBrowse',\r\n  data() {\r\n    return {\r\n      activityList: [],\r\n      loading: false,\r\n      searchForm: {\r\n        activityType: '',\r\n        keyword: ''\r\n      }\r\n    }\r\n  },\r\n  mounted() {\r\n    this.loadActivityList()\r\n  },\r\n  methods: {\r\n    async loadActivityList() {\r\n      this.loading = true\r\n      try {\r\n        const res = await activityApi.getActivityList()\r\n        if (res.code === 200) {\r\n          this.activityList = res.data || []\r\n        }\r\n      } catch (error) {\r\n        console.error('加载活动列表失败:', error)\r\n      } finally {\r\n        this.loading = false\r\n      }\r\n    },\r\n    async handleRegister(row) {\r\n      try {\r\n        const res = await registrationApi.registerActivity({\r\n          activityId: row.activityId,\r\n          userId: this.$store.state.user.userId\r\n        })\r\n        if (res.code === 200) {\r\n          this.$message.success('报名成功')\r\n        }\r\n      } catch (error) {\r\n        console.error('报名失败:', error)\r\n      }\r\n    },\r\n    async handleSign(row) {\r\n      try {\r\n        const res = await signScoreApi.signActivity({\r\n          activityId: row.activityId,\r\n          userId: this.$store.state.user.userId,\r\n          score: 10\r\n        })\r\n        if (res.code === 200) {\r\n          this.$message.success('签到成功，获得10积分')\r\n        }\r\n      } catch (error) {\r\n        console.error('签到失败:', error)\r\n      }\r\n    },\r\n    handleEvaluate(row) {\r\n      this.$router.push(`/evaluation/${row.activityId}`)\r\n    },\r\n    handleSearch() {\r\n      this.loadActivityList()\r\n    },\r\n    handleReset() {\r\n      this.searchForm = {\r\n        activityType: '',\r\n        keyword: ''\r\n      }\r\n      this.loadActivityList()\r\n    },\r\n    formatDateTime(dateStr) {\r\n      if (!dateStr) return ''\r\n      const date = new Date(dateStr)\r\n      return date.toLocaleString('zh-CN')\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.activity-browse {\r\n  padding: 20px;\r\n}\r\n\r\n.search-form {\r\n  margin-bottom: 20px;\r\n}\r\n</style>\r\n"],"mappings":"AA0DA,SAAAA,WAAA,EAAAC,eAAA,EAAAC,YAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,YAAA;MACAC,OAAA;MACAC,UAAA;QACAC,YAAA;QACAC,OAAA;MACA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,gBAAA;EACA;EACAC,OAAA;IACA,MAAAD,iBAAA;MACA,KAAAL,OAAA;MACA;QACA,MAAAO,GAAA,SAAAb,WAAA,CAAAc,eAAA;QACA,IAAAD,GAAA,CAAAE,IAAA;UACA,KAAAV,YAAA,GAAAQ,GAAA,CAAAT,IAAA;QACA;MACA,SAAAY,KAAA;QACAC,OAAA,CAAAD,KAAA,cAAAA,KAAA;MACA;QACA,KAAAV,OAAA;MACA;