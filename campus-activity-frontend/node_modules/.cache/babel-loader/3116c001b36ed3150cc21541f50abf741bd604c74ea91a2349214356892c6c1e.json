{"ast":null,"code":"import { registrationApi, signScoreApi, evaluationApi } from '@/api';\nexport default {\n  name: 'MyRegistration',\n  data() {\n    return {\n      registrationList: [],\n      loading: false\n    };\n  },\n  mounted() {\n    this.loadRegistrationList();\n  },\n  methods: {\n    async loadRegistrationList() {\n      this.loading = true;\n      try {\n        const userId = this.$store.state.user.userId;\n\n        // 加载报名列表\n        const res = await registrationApi.getRegistrationList(userId);\n        if (res.code === 200) {\n          this.registrationList = res.data || [];\n\n          // 为每个报名记录加载活动详情、签到状态和评价状态\n          await this.loadAdditionalInfo();\n        }\n      } catch (error) {\n        console.error('加载报名列表失败:', error);\n      } finally {\n        this.loading = false;\n      }\n    },\n    async loadAdditionalInfo() {\n      const userId = this.$store.state.user.userId;\n\n      // 批量加载所有活动的签到和评价状态\n      const promises = this.registrationList.map(async registration => {\n        try {\n          // 检查是否已签到\n          const signRes = await signScoreApi.getSignListByActivity(registration.activityId);\n          if (signRes.code === 200) {\n            const signList = signRes.data || [];\n            registration.hasSigned = signList.some(sign => sign.userId === userId);\n          } else {\n            registration.hasSigned = false;\n          }\n\n          // 检查是否已评价\n          const evalRes = await evaluationApi.getEvaluationList(registration.activityId);\n          if (evalRes.code === 200) {\n            const evalList = evalRes.data || [];\n            registration.hasEvaluated = evalList.some(evaluation => evaluation.userId === userId);\n          } else {\n            registration.hasEvaluated = false;\n          }\n        } catch (error) {\n          console.error(`加载活动 ${registration.activityId} 附加信息失败:`, error);\n          registration.hasSigned = false;\n          registration.hasEvaluated = false;\n        }\n      });\n      await Promise.all(promises);\n\n      // 强制刷新视图\n      this.$forceUpdate();\n    },\n    async handleSign(row) {\n      try {\n        const res = await signScoreApi.signActivity({\n          activityId: row.activityId,\n          userId: this.$store.state.user.userId,\n          score: 10\n        });\n        if (res.code === 200) {\n          this.$message.success('签到成功！获得10积分');\n          // 重新加载列表以更新签到状态\n          this.loadRegistrationList();\n        }\n      } catch (error) {\n        console.error('签到失败:', error);\n        this.$message.error(error.response?.data?.message || '签到失败');\n      }\n    },\n    handleEvaluate(row) {\n      // 跳转到评价页面\n      this.$router.push(`/student/evaluation/${row.activityId}`);\n    },\n    async handleCancel(row) {\n      try {\n        await this.$confirm('确定要取消报名吗?', '提示', {\n          confirmButtonText: '确定',\n          cancelButtonText: '取消',\n          type: 'warning'\n        });\n        const res = await registrationApi.cancelRegistration(row.registerId);\n        if (res.code === 200) {\n          this.$message.success('取消报名成功');\n          this.loadRegistrationList();\n        }\n      } catch (error) {\n        if (error !== 'cancel') {\n          console.error('取消报名失败:', error);\n          this.$message.error('取消报名失败');\n        }\n      }\n    },\n    getStatusType(status) {\n      const statusMap = {\n        '通过': 'success',\n        '拒绝': 'danger',\n        '待审': 'warning'\n      };\n      return statusMap[status] || 'info';\n    },\n    formatDateTime(dateStr) {\n      if (!dateStr) return '';\n      const date = new Date(dateStr);\n      return date.toLocaleString('zh-CN');\n    }\n  }\n};","map":{"version":3,"names":["registrationApi","signScoreApi","evaluationApi","name","data","registrationList","loading","mounted","loadRegistrationList","methods","userId","$store","state","user","res","getRegistrationList","code","loadAdditionalInfo","error","console","promises","map","registration","signRes","getSignListByActivity","activityId","signList","hasSigned","some","sign","evalRes","getEvaluationList","evalList","hasEvaluated","evaluation","Promise","all","$forceUpdate","handleSign","row","signActivity","score","$message","success","response","message","handleEvaluate","$router","push","handleCancel","$confirm","confirmButtonText","cancelButtonText","type","cancelRegistration","registerId","getStatusType","status","statusMap","formatDateTime","dateStr","date","Date","toLocaleString"],"sources":["src/views/student/MyRegistration.vue"],"sourcesContent":["<template>\n  <div class=\"my-registration\">\n    <el-card>\n      <div slot=\"header\">\n        <span>我的报名</span>\n      </div>\n      \n      <el-table :data=\"registrationList\" border style=\"width: 100%\" v-loading=\"loading\">\n        <el-table-column prop=\"activityName\" label=\"活动名称\" min-width=\"150\"></el-table-column>\n        <el-table-column prop=\"activityType\" label=\"活动类型\" width=\"100\"></el-table-column>\n        <el-table-column prop=\"location\" label=\"活动地点\" width=\"120\"></el-table-column>\n        <el-table-column prop=\"startTime\" label=\"开始时间\" width=\"180\">\n          <template slot-scope=\"scope\">\n            {{ formatDateTime(scope.row.startTime) }}\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"registerTime\" label=\"报名时间\" width=\"180\">\n          <template slot-scope=\"scope\">\n            {{ formatDateTime(scope.row.registerTime) }}\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"auditStatus\" label=\"审核状态\" width=\"100\">\n          <template slot-scope=\"scope\">\n            <el-tag :type=\"getStatusType(scope.row.auditStatus)\">\n              {{ scope.row.auditStatus || '待审' }}\n            </el-tag>\n          </template>\n        </el-table-column>\n        <el-table-column label=\"签到状态\" width=\"100\">\n          <template slot-scope=\"scope\">\n            <el-tag :type=\"scope.row.hasSigned ? 'success' : 'info'\">\n              {{ scope.row.hasSigned ? '已签到' : '未签到' }}\n            </el-tag>\n          </template>\n        </el-table-column>\n        <el-table-column label=\"操作\" width=\"260\" fixed=\"right\">\n          <template slot-scope=\"scope\">\n            <!-- 待审状态：可以取消报名 -->\n            <el-button \n              v-if=\"scope.row.auditStatus === '待审' || !scope.row.auditStatus\"\n              size=\"mini\" \n              type=\"danger\"\n              @click=\"handleCancel(scope.row)\">取消报名</el-button>\n            \n            <!-- 审核通过且未签到：显示签到按钮 -->\n            <el-button \n              v-if=\"scope.row.auditStatus === '通过' && !scope.row.hasSigned\"\n              size=\"mini\" \n              type=\"primary\"\n              @click=\"handleSign(scope.row)\">签到</el-button>\n            \n            <!-- 已签到且未评价：显示评价按钮 -->\n            <el-button \n              v-if=\"scope.row.hasSigned && !scope.row.hasEvaluated\"\n              size=\"mini\" \n              type=\"success\"\n              @click=\"handleEvaluate(scope.row)\">评价活动</el-button>\n            \n            <!-- 已评价：显示标签 -->\n            <el-tag v-if=\"scope.row.hasEvaluated\" type=\"success\" size=\"small\">已评价</el-tag>\n            \n            <!-- 审核拒绝：显示原因（如果有） -->\n            <span v-if=\"scope.row.auditStatus === '拒绝'\" style=\"color: #909399; font-size: 12px;\">\n              已拒绝\n            </span>\n          </template>\n        </el-table-column>\n      </el-table>\n    </el-card>\n  </div>\n</template>\n\n<script>\nimport { registrationApi, signScoreApi, evaluationApi } from '@/api'\n\nexport default {\n  name: 'MyRegistration',\n  data() {\n    return {\n      registrationList: [],\n      loading: false\n    }\n  },\n  mounted() {\n    this.loadRegistrationList()\n  },\n  methods: {\n    async loadRegistrationList() {\n      this.loading = true\n      try {\n        const userId = this.$store.state.user.userId\n        \n        // 加载报名列表\n        const res = await registrationApi.getRegistrationList(userId)\n        if (res.code === 200) {\n          this.registrationList = res.data || []\n          \n          // 为每个报名记录加载活动详情、签到状态和评价状态\n          await this.loadAdditionalInfo()\n        }\n      } catch (error) {\n        console.error('加载报名列表失败:', error)\n      } finally {\n        this.loading = false\n      }\n    },\n    \n    async loadAdditionalInfo() {\n      const userId = this.$store.state.user.userId\n      \n      // 批量加载所有活动的签到和评价状态\n      const promises = this.registrationList.map(async (registration) => {\n        try {\n          // 检查是否已签到\n          const signRes = await signScoreApi.getSignListByActivity(registration.activityId)\n          if (signRes.code === 200) {\n            const signList = signRes.data || []\n            registration.hasSigned = signList.some(sign => sign.userId === userId)\n          } else {\n            registration.hasSigned = false\n          }\n          \n          // 检查是否已评价\n          const evalRes = await evaluationApi.getEvaluationList(registration.activityId)\n          if (evalRes.code === 200) {\n            const evalList = evalRes.data || []\n            registration.hasEvaluated = evalList.some(evaluation => evaluation.userId === userId)\n          } else {\n            registration.hasEvaluated = false\n          }\n        } catch (error) {\n          console.error(`加载活动 ${registration.activityId} 附加信息失败:`, error)\n          registration.hasSigned = false\n          registration.hasEvaluated = false\n        }\n      })\n      \n      await Promise.all(promises)\n      \n      // 强制刷新视图\n      this.$forceUpdate()\n    },\n    \n    async handleSign(row) {\n      try {\n        const res = await signScoreApi.signActivity({\n          activityId: row.activityId,\n          userId: this.$store.state.user.userId,\n          score: 10\n        })\n        if (res.code === 200) {\n          this.$message.success('签到成功！获得10积分')\n          // 重新加载列表以更新签到状态\n          this.loadRegistrationList()\n        }\n      } catch (error) {\n        console.error('签到失败:', error)\n        this.$message.error(error.response?.data?.message || '签到失败')\n      }\n    },\n    \n    handleEvaluate(row) {\n      // 跳转到评价页面\n      this.$router.push(`/student/evaluation/${row.activityId}`)\n    },\n    \n    async handleCancel(row) {\n      try {\n        await this.$confirm('确定要取消报名吗?', '提示', {\n          confirmButtonText: '确定',\n          cancelButtonText: '取消',\n          type: 'warning'\n        })\n        \n        const res = await registrationApi.cancelRegistration(row.registerId)\n        if (res.code === 200) {\n          this.$message.success('取消报名成功')\n          this.loadRegistrationList()\n        }\n      } catch (error) {\n        if (error !== 'cancel') {\n          console.error('取消报名失败:', error)\n          this.$message.error('取消报名失败')\n        }\n      }\n    },\n    \n    getStatusType(status) {\n      const statusMap = {\n        '通过': 'success',\n        '拒绝': 'danger',\n        '待审': 'warning'\n      }\n      return statusMap[status] || 'info'\n    },\n    \n    formatDateTime(dateStr) {\n      if (!dateStr) return ''\n      const date = new Date(dateStr)\n      return date.toLocaleString('zh-CN')\n    }\n  }\n}\n</script>\n\n<style scoped>\n.my-registration {\n  padding: 20px;\n}\n</style>\n"],"mappings":"AAyEA,SAAAA,eAAA,EAAAC,YAAA,EAAAC,aAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,gBAAA;MACAC,OAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,oBAAA;EACA;EACAC,OAAA;IACA,MAAAD,qBAAA;MACA,KAAAF,OAAA;MACA;QACA,MAAAI,MAAA,QAAAC,MAAA,CAAAC,KAAA,CAAAC,IAAA,CAAAH,MAAA;;QAEA;QACA,MAAAI,GAAA,SAAAd,eAAA,CAAAe,mBAAA,CAAAL,MAAA;QACA,IAAAI,GAAA,CAAAE,IAAA;UACA,KAAAX,gBAAA,GAAAS,GAAA,CAAAV,IAAA;;UAEA;UACA,WAAAa,kBAAA;QACA;MACA,SAAAC,KAAA;QACAC,OAAA,CAAAD,KAAA,cAAAA,KAAA;MACA;QACA,KAAAZ,OAAA;MACA;IACA;IAEA,MAAAW,mBAAA;MACA,MAAAP,MAAA,QAAAC,MAAA,CAAAC,KAAA,CAAAC,IAAA,CAAAH,MAAA;;MAEA;MACA,MAAAU,QAAA,QAAAf,gBAAA,CAAAgB,GAAA,OAAAC,YAAA;QACA;UACA;UACA,MAAAC,OAAA,SAAAtB,YAAA,CAAAuB,qBAAA,CAAAF,YAAA,CAAAG,UAAA;UACA,IAAAF,OAAA,CAAAP,IAAA;YACA,MAAAU,QAAA,GAAAH,OAAA,CAAAnB,IAAA;YACAkB,YAAA,CAAAK,SAAA,GAAAD,QAAA,CAAAE,IAAA,CAAAC,IAAA,IAAAA,IAAA,CAAAnB,MAAA,KAAAA,MAAA;UACA;YACAY,YAAA,CAAAK,SAAA;UACA;;UAEA;UACA,MAAAG,OAAA,SAAA5B,aAAA,CAAA6B,iBAAA,CAAAT,YAAA,CAAAG,UAAA;UACA,IAAAK,OAAA,CAAAd,IAAA;YACA,MAAAgB,QAAA,GAAAF,OAAA,CAAA1B,IAAA;YACAkB,YAAA,CAAAW,YAAA,GAAAD,QAAA,CAAAJ,IAAA,CAAAM,UAAA,IAAAA,UAAA,CAAAxB,MAAA,KAAAA,MAAA;UACA;YACAY,YAAA,CAAAW,YAAA;UACA;QACA,SAAAf,KAAA;UACAC,OAAA,CAAAD,KAAA,SAAAI,YAAA,CAAAG,UAAA,YAAAP,KAAA;UACAI,YAAA,CAAAK,SAAA;UACAL,YAAA,CAAAW,YAAA;QACA;MACA;MAEA,MAAAE,OAAA,CAAAC,GAAA,CAAAhB,QAAA;;MAEA;MACA,KAAAiB,YAAA;IACA;IAEA,MAAAC,WAAAC,GAAA;MACA;QACA,MAAAzB,GAAA,SAAAb,YAAA,CAAAuC,YAAA;UACAf,UAAA,EAAAc,GAAA,CAAAd,UAAA;UACAf,MAAA,OAAAC,MAAA,CAAAC,KAAA,CAAAC,IAAA,CAAAH,MAAA;UACA+B,KAAA;QACA;QACA,IAAA3B,GAAA,CAAAE,IAAA;UACA,KAAA0B,QAAA,CAAAC,OAAA;UACA;UACA,KAAAnC,oBAAA;QACA;MACA,SAAAU,KAAA;QACAC,OAAA,CAAAD,KAAA,UAAAA,KAAA;QACA,KAAAwB,QAAA,CAAAxB,KAAA,CAAAA,KAAA,CAAA0B,QAAA,EAAAxC,IAAA,EAAAyC,OAAA;MACA;IACA;IAEAC,eAAAP,GAAA;MACA;MACA,KAAAQ,OAAA,CAAAC,IAAA,wBAAAT,GAAA,CAAAd,UAAA;IACA;IAEA,MAAAwB,aAAAV,GAAA;MACA;QACA,WAAAW,QAAA;UACAC,iBAAA;UACAC,gBAAA;UACAC,IAAA;QACA;QAEA,MAAAvC,GAAA,SAAAd,eAAA,CAAAsD,kBAAA,CAAAf,GAAA,CAAAgB,UAAA;QACA,IAAAzC,GAAA,CAAAE,IAAA;UACA,KAAA0B,QAAA,CAAAC,OAAA;UACA,KAAAnC,oBAAA;QACA;MACA,SAAAU,KAAA;QACA,IAAAA,KAAA;UACAC,OAAA,CAAAD,KAAA,YAAAA,KAAA;UACA,KAAAwB,QAAA,CAAAxB,KAAA;QACA;MACA;IACA;IAEAsC,cAAAC,MAAA;MACA,MAAAC,SAAA;QACA;QACA;QACA;MACA;MACA,OAAAA,SAAA,CAAAD,MAAA;IACA;IAEAE,eAAAC,OAAA;MACA,KAAAA,OAAA;MACA,MAAAC,IAAA,OAAAC,IAAA,CAAAF,OAAA;MACA,OAAAC,IAAA,CAAAE,cAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}