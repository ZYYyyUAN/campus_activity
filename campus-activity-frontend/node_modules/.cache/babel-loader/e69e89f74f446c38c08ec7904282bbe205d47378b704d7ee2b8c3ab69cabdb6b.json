{"ast":null,"code":"import { registrationApi, auditApi } from '@/api';\nexport default {\n  name: 'RegistrationAudit',\n  data() {\n    return {\n      registrationList: [],\n      loading: false\n    };\n  },\n  mounted() {\n    this.loadRegistrationList();\n  },\n  methods: {\n    async loadRegistrationList() {\n      this.loading = true;\n      try {\n        // 获取发布者发布的所有活动的报名列表\n        const publisherId = this.$store.state.user.userId;\n        const res = await registrationApi.getRegistrationByPublisher(publisherId);\n        if (res.code === 200) {\n          this.registrationList = res.data || [];\n        }\n      } catch (error) {\n        console.error('加载报名列表失败:', error);\n      } finally {\n        this.loading = false;\n      }\n    },\n    async handleAudit(row, result) {\n      try {\n        const res = await auditApi.auditRegistration({\n          registerId: row.registerId,\n          auditorId: this.$store.state.user.userId,\n          auditResult: result,\n          auditComment: result === '通过' ? '审核通过' : '审核拒绝'\n        });\n        if (res.code === 200) {\n          this.$message.success(`审核${result}成功`);\n          this.loadRegistrationList();\n        }\n      } catch (error) {\n        console.error('审核失败:', error);\n      }\n    },\n    getStatusType(status) {\n      const statusMap = {\n        '通过': 'success',\n        '拒绝': 'danger',\n        '待审': 'warning'\n      };\n      return statusMap[status] || 'info';\n    },\n    formatDateTime(dateStr) {\n      if (!dateStr) return '';\n      const date = new Date(dateStr);\n      return date.toLocaleString('zh-CN');\n    }\n  }\n};","map":{"version":3,"names":["registrationApi","auditApi","name","data","registrationList","loading","mounted","loadRegistrationList","methods","publisherId","$store","state","user","userId","res","getRegistrationByPublisher","code","error","console","handleAudit","row","result","auditRegistration","registerId","auditorId","auditResult","auditComment","$message","success","getStatusType","status","statusMap","formatDateTime","dateStr","date","Date","toLocaleString"],"sources":["src/views/publisher/RegistrationAudit.vue"],"sourcesContent":["<template>\n  <div class=\"registration-audit\">\n    <el-card>\n      <div slot=\"header\">\n        <span>报名审核</span>\n      </div>\n      \n      <el-table :data=\"registrationList\" border style=\"width: 100%\" v-loading=\"loading\">\n        <el-table-column prop=\"activityName\" label=\"活动名称\" min-width=\"150\"></el-table-column>\n        <el-table-column prop=\"realName\" label=\"报名学生\" width=\"120\"></el-table-column>\n        <el-table-column prop=\"registerTime\" label=\"报名时间\" width=\"180\">\n          <template slot-scope=\"scope\">\n            {{ formatDateTime(scope.row.registerTime) }}\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"auditStatus\" label=\"审核状态\" width=\"120\">\n          <template slot-scope=\"scope\">\n            <el-tag :type=\"getStatusType(scope.row.auditStatus)\">\n              {{ scope.row.auditStatus || '待审' }}\n            </el-tag>\n          </template>\n        </el-table-column>\n        <el-table-column label=\"操作\" width=\"200\" fixed=\"right\">\n          <template slot-scope=\"scope\">\n            <el-button \n              size=\"mini\" \n              type=\"success\" \n              v-if=\"scope.row.auditStatus === '待审' || !scope.row.auditStatus\"\n              @click=\"handleAudit(scope.row, '通过')\">通过</el-button>\n            <el-button \n              size=\"mini\" \n              type=\"danger\" \n              v-if=\"scope.row.auditStatus === '待审' || !scope.row.auditStatus\"\n              @click=\"handleAudit(scope.row, '拒绝')\">拒绝</el-button>\n            <span v-else>已审核</span>\n          </template>\n        </el-table-column>\n      </el-table>\n    </el-card>\n  </div>\n</template>\n\n<script>\nimport { registrationApi, auditApi } from '@/api'\n\nexport default {\n  name: 'RegistrationAudit',\n  data() {\n    return {\n      registrationList: [],\n      loading: false\n    }\n  },\n  mounted() {\n    this.loadRegistrationList()\n  },\n  methods: {\n    async loadRegistrationList() {\n      this.loading = true\n      try {\n        // 获取发布者发布的所有活动的报名列表\n        const publisherId = this.$store.state.user.userId\n        const res = await registrationApi.getRegistrationByPublisher(publisherId)\n        if (res.code === 200) {\n          this.registrationList = res.data || []\n        }\n      } catch (error) {\n        console.error('加载报名列表失败:', error)\n      } finally {\n        this.loading = false\n      }\n    },\n    async handleAudit(row, result) {\n      try {\n        const res = await auditApi.auditRegistration({\n          registerId: row.registerId,\n          auditorId: this.$store.state.user.userId,\n          auditResult: result,\n          auditComment: result === '通过' ? '审核通过' : '审核拒绝'\n        })\n        if (res.code === 200) {\n          this.$message.success(`审核${result}成功`)\n          this.loadRegistrationList()\n        }\n      } catch (error) {\n        console.error('审核失败:', error)\n      }\n    },\n    getStatusType(status) {\n      const statusMap = {\n        '通过': 'success',\n        '拒绝': 'danger',\n        '待审': 'warning'\n      }\n      return statusMap[status] || 'info'\n    },\n    formatDateTime(dateStr) {\n      if (!dateStr) return ''\n      const date = new Date(dateStr)\n      return date.toLocaleString('zh-CN')\n    }\n  }\n}\n</script>\n\n<style scoped>\n.registration-audit {\n  padding: 20px;\n}\n</style>\n"],"mappings":"AA2CA,SAAAA,eAAA,EAAAC,QAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,gBAAA;MACAC,OAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,oBAAA;EACA;EACAC,OAAA;IACA,MAAAD,qBAAA;MACA,KAAAF,OAAA;MACA;QACA;QACA,MAAAI,WAAA,QAAAC,MAAA,CAAAC,KAAA,CAAAC,IAAA,CAAAC,MAAA;QACA,MAAAC,GAAA,SAAAd,eAAA,CAAAe,0BAAA,CAAAN,WAAA;QACA,IAAAK,GAAA,CAAAE,IAAA;UACA,KAAAZ,gBAAA,GAAAU,GAAA,CAAAX,IAAA;QACA;MACA,SAAAc,KAAA;QACAC,OAAA,CAAAD,KAAA,cAAAA,KAAA;MACA;QACA,KAAAZ,OAAA;MACA;IACA;IACA,MAAAc,YAAAC,GAAA,EAAAC,MAAA;MACA;QACA,MAAAP,GAAA,SAAAb,QAAA,CAAAqB,iBAAA;UACAC,UAAA,EAAAH,GAAA,CAAAG,UAAA;UACAC,SAAA,OAAAd,MAAA,CAAAC,KAAA,CAAAC,IAAA,CAAAC,MAAA;UACAY,WAAA,EAAAJ,MAAA;UACAK,YAAA,EAAAL,MAAA;QACA;QACA,IAAAP,GAAA,CAAAE,IAAA;UACA,KAAAW,QAAA,CAAAC,OAAA,MAAAP,MAAA;UACA,KAAAd,oBAAA;QACA;MACA,SAAAU,KAAA;QACAC,OAAA,CAAAD,KAAA,UAAAA,KAAA;MACA;IACA;IACAY,cAAAC,MAAA;MACA,MAAAC,SAAA;QACA;QACA;QACA;MACA;MACA,OAAAA,SAAA,CAAAD,MAAA;IACA;IACAE,eAAAC,OAAA;MACA,KAAAA,OAAA;MACA,MAAAC,IAAA,OAAAC,IAAA,CAAAF,OAAA;MACA,OAAAC,IAAA,CAAAE,cAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}