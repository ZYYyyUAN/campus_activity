{"ast":null,"code":"import { activityApi } from '@/api';\nexport default {\n  name: 'ActivityList',\n  data() {\n    return {\n      activityList: [],\n      loading: false,\n      searchForm: {\n        activityType: '',\n        keyword: ''\n      }\n    };\n  },\n  computed: {\n    isAdmin() {\n      return this.$store.getters.isAdmin;\n    },\n    isPublisher() {\n      return this.$store.getters.isPublisher;\n    },\n    isStudent() {\n      return this.$store.getters.isStudent;\n    },\n    currentUserId() {\n      return this.$store.state.user ? this.$store.state.user.userId : null;\n    }\n  },\n  mounted() {\n    this.loadActivityList();\n  },\n  methods: {\n    async loadActivityList() {\n      this.loading = true;\n      try {\n        const res = await activityApi.getActivityList();\n        if (res.code === 200) {\n          this.activityList = res.data || [];\n        }\n      } catch (error) {\n        console.error('加载活动列表失败:', error);\n      } finally {\n        this.loading = false;\n      }\n    },\n    handleAdd() {\n      this.$router.push('/activity/add');\n    },\n    handleEdit(row) {\n      this.$router.push(`/activity/edit/${row.activityId}`);\n    },\n    handleDelete(row) {\n      this.$confirm(`确定要删除活动\"${row.activityName}\"吗?`, '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(async () => {\n        try {\n          const res = await activityApi.deleteActivity(row.activityId);\n          if (res.code === 200) {\n            this.$message.success('删除成功');\n            this.loadActivityList();\n          }\n        } catch (error) {\n          console.error('删除失败:', error);\n        }\n      });\n    },\n    handleSearch() {\n      this.loadActivityList();\n    },\n    handleReset() {\n      this.searchForm = {\n        activityType: '',\n        keyword: ''\n      };\n      this.loadActivityList();\n    },\n    formatDateTime(dateStr) {\n      if (!dateStr) return '';\n      const date = new Date(dateStr);\n      return date.toLocaleString('zh-CN', {\n        year: 'numeric',\n        month: '2-digit',\n        day: '2-digit',\n        hour: '2-digit',\n        minute: '2-digit'\n      });\n    }\n  }\n};","map":{"version":3,"names":["activityApi","name","data","activityList","loading","searchForm","activityType","keyword","computed","isAdmin","$store","getters","isPublisher","isStudent","currentUserId","state","user","userId","mounted","loadActivityList","methods","res","getActivityList","code","error","console","handleAdd","$router","push","handleEdit","row","activityId","handleDelete","$confirm","activityName","confirmButtonText","cancelButtonText","type","then","deleteActivity","$message","success","handleSearch","handleReset","formatDateTime","dateStr","date","Date","toLocaleString","year","month","day","hour","minute"],"sources":["src/views/activity/ActivityList.vue"],"sourcesContent":["<template>\r\n  <div class=\"activity-list\">\r\n    <el-card>\r\n      <div slot=\"header\" class=\"card-header\">\r\n        <span>活动列表</span>\r\n        <el-button \r\n          type=\"primary\" \r\n          icon=\"el-icon-plus\" \r\n          @click=\"handleAdd\"\r\n          v-if=\"isAdmin || isPublisher\">新增活动</el-button>\r\n      </div>\r\n      \r\n      <!-- 搜索栏 -->\r\n      <el-form :inline=\"true\" :model=\"searchForm\" class=\"search-form\">\r\n        <el-form-item label=\"活动类型\">\r\n          <el-select v-model=\"searchForm.activityType\" placeholder=\"请选择\" clearable>\r\n            <el-option label=\"讲座\" value=\"讲座\"></el-option>\r\n            <el-option label=\"比赛\" value=\"比赛\"></el-option>\r\n            <el-option label=\"学术论坛\" value=\"学术论坛\"></el-option>\r\n            <el-option label=\"班级活动\" value=\"班级活动\"></el-option>\r\n            <el-option label=\"志愿服务\" value=\"志愿服务\"></el-option>\r\n          </el-select>\r\n        </el-form-item>\r\n        <el-form-item label=\"关键词\">\r\n          <el-input v-model=\"searchForm.keyword\" placeholder=\"活动名称/地点\" clearable></el-input>\r\n        </el-form-item>\r\n        <el-form-item>\r\n          <el-button type=\"primary\" icon=\"el-icon-search\" @click=\"handleSearch\">查询</el-button>\r\n          <el-button icon=\"el-icon-refresh\" @click=\"handleReset\">重置</el-button>\r\n        </el-form-item>\r\n      </el-form>\r\n      \r\n      <!-- 活动表格 -->\r\n      <el-table :data=\"activityList\" border style=\"width: 100%\" v-loading=\"loading\">\r\n        <el-table-column prop=\"activityId\" label=\"活动ID\" width=\"80\"></el-table-column>\r\n        <el-table-column prop=\"activityName\" label=\"活动名称\" min-width=\"150\"></el-table-column>\r\n        <el-table-column prop=\"activityType\" label=\"活动类型\" width=\"120\"></el-table-column>\r\n        <el-table-column prop=\"location\" label=\"活动地点\" width=\"150\"></el-table-column>\r\n        <el-table-column prop=\"startTime\" label=\"开始时间\" width=\"180\">\r\n          <template slot-scope=\"scope\">\r\n            {{ formatDateTime(scope.row.startTime) }}\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column prop=\"endTime\" label=\"结束时间\" width=\"180\">\r\n          <template slot-scope=\"scope\">\r\n            {{ formatDateTime(scope.row.endTime) }}\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column prop=\"maxPeople\" label=\"人数上限\" width=\"100\"></el-table-column>\r\n        <el-table-column prop=\"publisherName\" label=\"发布者\" width=\"120\"></el-table-column>\r\n        <el-table-column prop=\"status\" label=\"状态\" width=\"100\">\r\n          <template slot-scope=\"scope\">\r\n            <el-tag :type=\"scope.row.status === '报名中' ? 'success' : 'info'\">\r\n              {{ scope.row.status }}\r\n            </el-tag>\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column label=\"操作\" width=\"200\" fixed=\"right\">\r\n          <template slot-scope=\"scope\">\r\n            <el-button \r\n              size=\"mini\" \r\n              @click=\"handleEdit(scope.row)\"\r\n              v-if=\"isAdmin || (isPublisher && scope.row.publisherId === currentUserId)\">编辑</el-button>\r\n            <el-button \r\n              size=\"mini\" \r\n              type=\"danger\" \r\n              @click=\"handleDelete(scope.row)\"\r\n              v-if=\"isAdmin || (isPublisher && scope.row.publisherId === currentUserId)\">删除</el-button>\r\n            <span v-if=\"isStudent\">-</span>\r\n          </template>\r\n        </el-table-column>\r\n      </el-table>\r\n    </el-card>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { activityApi } from '@/api'\r\n\r\nexport default {\r\n  name: 'ActivityList',\r\n  data() {\r\n    return {\r\n      activityList: [],\r\n      loading: false,\r\n      searchForm: {\r\n        activityType: '',\r\n        keyword: ''\r\n      }\r\n    }\r\n  },\r\n  computed: {\r\n    isAdmin() {\r\n      return this.$store.getters.isAdmin\r\n    },\r\n    isPublisher() {\r\n      return this.$store.getters.isPublisher\r\n    },\r\n    isStudent() {\r\n      return this.$store.getters.isStudent\r\n    },\r\n    currentUserId() {\r\n      return this.$store.state.user ? this.$store.state.user.userId : null\r\n    }\r\n  },\r\n  mounted() {\r\n    this.loadActivityList()\r\n  },\r\n  methods: {\r\n    async loadActivityList() {\r\n      this.loading = true\r\n      try {\r\n        const res = await activityApi.getActivityList()\r\n        if (res.code === 200) {\r\n          this.activityList = res.data || []\r\n        }\r\n      } catch (error) {\r\n        console.error('加载活动列表失败:', error)\r\n      } finally {\r\n        this.loading = false\r\n      }\r\n    },\r\n    handleAdd() {\r\n      this.$router.push('/activity/add')\r\n    },\r\n    handleEdit(row) {\r\n      this.$router.push(`/activity/edit/${row.activityId}`)\r\n    },\r\n    handleDelete(row) {\r\n      this.$confirm(`确定要删除活动\"${row.activityName}\"吗?`, '提示', {\r\n        confirmButtonText: '确定',\r\n        cancelButtonText: '取消',\r\n        type: 'warning'\r\n      }).then(async () => {\r\n        try {\r\n          const res = await activityApi.deleteActivity(row.activityId)\r\n          if (res.code === 200) {\r\n            this.$message.success('删除成功')\r\n            this.loadActivityList()\r\n          }\r\n        } catch (error) {\r\n          console.error('删除失败:', error)\r\n        }\r\n      })\r\n    },\r\n    handleSearch() {\r\n      this.loadActivityList()\r\n    },\r\n    handleReset() {\r\n      this.searchForm = {\r\n        activityType: '',\r\n        keyword: ''\r\n      }\r\n      this.loadActivityList()\r\n    },\r\n    formatDateTime(dateStr) {\r\n      if (!dateStr) return ''\r\n      const date = new Date(dateStr)\r\n      return date.toLocaleString('zh-CN', {\r\n        year: 'numeric',\r\n        month: '2-digit',\r\n        day: '2-digit',\r\n        hour: '2-digit',\r\n        minute: '2-digit'\r\n      })\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.activity-list {\r\n  padding: 20px;\r\n}\r\n\r\n.card-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n}\r\n\r\n.search-form {\r\n  margin-bottom: 20px;\r\n}\r\n</style>\r\n\r\n"],"mappings":"AA6EA,SAAAA,WAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,YAAA;MACAC,OAAA;MACAC,UAAA;QACAC,YAAA;QACAC,OAAA;MACA;IACA;EACA;EACAC,QAAA;IACAC,QAAA;MACA,YAAAC,MAAA,CAAAC,OAAA,CAAAF,OAAA;IACA;IACAG,YAAA;MACA,YAAAF,MAAA,CAAAC,OAAA,CAAAC,WAAA;IACA;IACAC,UAAA;MACA,YAAAH,MAAA,CAAAC,OAAA,CAAAE,SAAA;IACA;IACAC,cAAA;MACA,YAAAJ,MAAA,CAAAK,KAAA,CAAAC,IAAA,QAAAN,MAAA,CAAAK,KAAA,CAAAC,IAAA,CAAAC,MAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,gBAAA;EACA;EACAC,OAAA;IACA,MAAAD,iBAAA;MACA,KAAAf,OAAA;MACA;QACA,MAAAiB,GAAA,SAAArB,WAAA,CAAAsB,eAAA;QACA,IAAAD,GAAA,CAAAE,IAAA;UACA,KAAApB,YAAA,GAAAkB,GAAA,CAAAnB,IAAA;QACA;MACA,SAAAsB,KAAA;QACAC,OAAA,CAAAD,KAAA,cAAAA,KAAA;MACA;QACA,KAAApB,OAAA;MACA;IACA;IACAsB,UAAA;MACA,KAAAC,OAAA,CAAAC,IAAA;IACA;IACAC,WAAAC,G