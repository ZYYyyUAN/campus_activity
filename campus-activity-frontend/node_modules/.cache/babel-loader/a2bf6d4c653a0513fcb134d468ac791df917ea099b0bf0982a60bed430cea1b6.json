{"ast":null,"code":"export default {\n  name: 'MainLayout',\n  computed: {\n    user() {\n      return this.$store.state.user || {};\n    },\n    isAdmin() {\n      return this.$store.getters.isAdmin;\n    },\n    isPublisher() {\n      return this.$store.getters.isPublisher;\n    },\n    isStudent() {\n      return this.$store.getters.isStudent;\n    },\n    activeMenu() {\n      return this.$route.path;\n    }\n  },\n  methods: {\n    handleCommand(command) {\n      if (command === 'logout') {\n        this.$confirm('确定要退出登录吗?', '提示', {\n          confirmButtonText: '确定',\n          cancelButtonText: '取消',\n          type: 'warning'\n        }).then(() => {\n          this.$store.dispatch('logout');\n          this.$message.success('已退出登录');\n          this.$router.push('/login');\n        });\n      }\n    }\n  }\n};","map":{"version":3,"names":["name","computed","user","$store","state","isAdmin","getters","isPublisher","isStudent","activeMenu","$route","path","methods","handleCommand","command","$confirm","confirmButtonText","cancelButtonText","type","then","dispatch","$message","success","$router","push"],"sources":["src/layout/MainLayout.vue"],"sourcesContent":["<template>\r\n  <el-container class=\"main-container\">\r\n    <el-header class=\"header\">\r\n      <div class=\"header-left\">\r\n        <h2>校园活动报名管理系统</h2>\r\n      </div>\r\n      <div class=\"header-right\">\r\n        <el-dropdown @command=\"handleCommand\">\r\n          <span class=\"user-info\">\r\n            <i class=\"el-icon-user\"></i>\r\n            {{ user.realName || user.username }}\r\n            <i class=\"el-icon-arrow-down el-icon--right\"></i>\r\n          </span>\r\n          <el-dropdown-menu slot=\"dropdown\">\r\n            <el-dropdown-item command=\"logout\">退出登录</el-dropdown-item>\r\n          </el-dropdown-menu>\r\n        </el-dropdown>\r\n      </div>\r\n    </el-header>\r\n    <el-container>\r\n      <el-aside width=\"200px\" class=\"sidebar\">\r\n        <el-menu\r\n          :default-active=\"activeMenu\"\r\n          router\r\n          background-color=\"#304156\"\r\n          text-color=\"#bfcbd9\"\r\n          active-text-color=\"#409EFF\"\r\n        >\r\n          <el-menu-item index=\"/dashboard\">\r\n            <i class=\"el-icon-data-line\"></i>\r\n            <span>首页</span>\r\n          </el-menu-item>\r\n          \r\n          <!-- 管理员菜单 -->\r\n          <template v-if=\"isAdmin\">\r\n            <el-menu-item index=\"/activity\">\r\n              <i class=\"el-icon-tickets\"></i>\r\n              <span>活动管理</span>\r\n            </el-menu-item>\r\n            <el-menu-item index=\"/user\">\r\n              <i class=\"el-icon-user\"></i>\r\n              <span>用户管理</span>\r\n            </el-menu-item>\r\n            <el-menu-item index=\"/log\">\r\n              <i class=\"el-icon-document\"></i>\r\n              <span>日志管理</span>\r\n            </el-menu-item>\r\n          </template>\r\n          \r\n          <!-- 发布者菜单 -->\r\n          <template v-if=\"isPublisher\">\r\n            <el-menu-item index=\"/activity\">\r\n              <i class=\"el-icon-tickets\"></i>\r\n              <span>活动管理</span>\r\n            </el-menu-item>\r\n            <el-menu-item index=\"/publisher/audit\">\r\n              <i class=\"el-icon-check\"></i>\r\n              <span>报名审核</span>\r\n            </el-menu-item>\r\n            <el-menu-item index=\"/publisher/statistics\">\r\n              <i class=\"el-icon-data-analysis\"></i>\r\n              <span>参与情况</span>\r\n            </el-menu-item>\r\n          </template>\r\n          \r\n          <!-- 学生菜单 -->\r\n          <template v-if=\"isStudent\">\r\n            <el-menu-item index=\"/student/browse\">\r\n              <i class=\"el-icon-view\"></i>\r\n              <span>活动浏览</span>\r\n            </el-menu-item>\r\n            <el-menu-item index=\"/student/registration\">\r\n              <i class=\"el-icon-edit-outline\"></i>\r\n              <span>我的报名</span>\r\n            </el-menu-item>\r\n            <el-menu-item index=\"/student/signscore\">\r\n              <i class=\"el-icon-star-on\"></i>\r\n              <span>我的积分</span>\r\n            </el-menu-item>\r\n          </template>\r\n        </el-menu>\r\n      </el-aside>\r\n      <el-main class=\"main-content\">\r\n        <router-view></router-view>\r\n      </el-main>\r\n    </el-container>\r\n  </el-container>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'MainLayout',\r\n  computed: {\r\n    user() {\r\n      return this.$store.state.user || {}\r\n    },\r\n    isAdmin() {\r\n      return this.$store.getters.isAdmin\r\n    },\r\n    isPublisher() {\r\n      return this.$store.getters.isPublisher\r\n    },\r\n    isStudent() {\r\n      return this.$store.getters.isStudent\r\n    },\r\n    activeMenu() {\r\n      return this.$route.path\r\n    }\r\n  },\r\n  methods: {\r\n    handleCommand(command) {\r\n      if (command === 'logout') {\r\n        this.$confirm('确定要退出登录吗?', '提示', {\r\n          confirmButtonText: '确定',\r\n          cancelButtonText: '取消',\r\n          type: 'warning'\r\n        }).then(() => {\r\n          this.$store.dispatch('logout')\r\n          this.$message.success('已退出登录')\r\n          this.$router.push('/login')\r\n        })\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.main-container {\r\n  height: 100vh;\r\n}\r\n\r\n.header {\r\n  background: #304156;\r\n  color: white;\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  padding: 0 20px;\r\n}\r\n\r\n.header-left h2 {\r\n  margin: 0;\r\n  font-size: 20px;\r\n}\r\n\r\n.header-right {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.user-info {\r\n  color: white;\r\n  cursor: pointer;\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.sidebar {\r\n  background: #304156;\r\n}\r\n\r\n.main-content {\r\n  background: #f0f2f5;\r\n  padding: 20px;\r\n}\r\n</style>\r\n\r\n"],"mappings":"AA0FA;EACAA,IAAA;