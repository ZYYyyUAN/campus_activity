{"ast":null,"code":"import { activityApi, registrationApi, signScoreApi } from '@/api';\nexport default {\n  name: 'ActivityStatistics',\n  data() {\n    return {\n      activityList: [],\n      registrationCountMap: {},\n      signCountMap: {},\n      loading: false\n    };\n  },\n  mounted() {\n    this.loadActivityList();\n  },\n  methods: {\n    async loadActivityList() {\n      this.loading = true;\n      try {\n        const publisherId = this.$store.state.user.userId;\n        const res = await activityApi.getActivityByPublisher(publisherId);\n        if (res.code === 200) {\n          this.activityList = res.data || [];\n          // 加载每个活动的统计数据\n          this.loadStatistics();\n        }\n      } catch (error) {\n        console.error('加载活动列表失败:', error);\n      } finally {\n        this.loading = false;\n      }\n    },\n    async loadStatistics() {\n      for (const activity of this.activityList) {\n        try {\n          const [regRes, signRes] = await Promise.all([registrationApi.getRegistrationCount(activity.activityId), signScoreApi.getSignCount(activity.activityId)]);\n          if (regRes.code === 200) {\n            this.$set(this.registrationCountMap, activity.activityId, regRes.data);\n          }\n          if (signRes.code === 200) {\n            this.$set(this.signCountMap, activity.activityId, signRes.data);\n          }\n        } catch (error) {\n          console.error('加载统计数据失败:', error);\n        }\n      }\n    },\n    getRegistrationCount(activityId) {\n      return this.registrationCountMap[activityId] || 0;\n    },\n    getSignCount(activityId) {\n      return this.signCountMap[activityId] || 0;\n    },\n    handleViewDetail(row) {\n      // 查看活动详情\n      this.$router.push(`/activity/${row.activityId}`);\n    },\n    formatDateTime(dateStr) {\n      if (!dateStr) return '';\n      const date = new Date(dateStr);\n      return date.toLocaleString('zh-CN');\n    }\n  }\n};","map":{"version":3,"names":["activityApi","registrationApi","signScoreApi","name","data","activityList","registrationCountMap","signCountMap","loading","mounted","loadActivityList","methods","publisherId","$store","state","user","userId","res","getActivityByPublisher","code","loadStatistics","error","console","activity","regRes","signRes","Promise","all","getRegistrationCount","activityId","getSignCount","$set","handleViewDetail","row","$router","push","formatDateTime","dateStr","date","Date","toLocaleString"],"sources":["src/views/publisher/ActivityStatistics.vue"],"sourcesContent":["<template>\n  <div class=\"activity-statistics\">\n    <el-card>\n      <div slot=\"header\">\n        <span>活动参与情况</span>\n      </div>\n      \n      <el-table :data=\"activityList\" border style=\"width: 100%\" v-loading=\"loading\">\n        <el-table-column prop=\"activityName\" label=\"活动名称\" min-width=\"150\"></el-table-column>\n        <el-table-column prop=\"activityType\" label=\"活动类型\" width=\"120\"></el-table-column>\n        <el-table-column prop=\"startTime\" label=\"开始时间\" width=\"180\">\n          <template slot-scope=\"scope\">\n            {{ formatDateTime(scope.row.startTime) }}\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"maxPeople\" label=\"人数上限\" width=\"100\"></el-table-column>\n        <el-table-column label=\"报名人数\" width=\"120\">\n          <template slot-scope=\"scope\">\n            {{ getRegistrationCount(scope.row.activityId) }}\n          </template>\n        </el-table-column>\n        <el-table-column label=\"签到人数\" width=\"120\">\n          <template slot-scope=\"scope\">\n            {{ getSignCount(scope.row.activityId) }}\n          </template>\n        </el-table-column>\n        <el-table-column label=\"操作\" width=\"150\">\n          <template slot-scope=\"scope\">\n            <el-button size=\"mini\" @click=\"handleViewDetail(scope.row)\">查看详情</el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n    </el-card>\n  </div>\n</template>\n\n<script>\nimport { activityApi, registrationApi, signScoreApi } from '@/api'\n\nexport default {\n  name: 'ActivityStatistics',\n  data() {\n    return {\n      activityList: [],\n      registrationCountMap: {},\n      signCountMap: {},\n      loading: false\n    }\n  },\n  mounted() {\n    this.loadActivityList()\n  },\n  methods: {\n    async loadActivityList() {\n      this.loading = true\n      try {\n        const publisherId = this.$store.state.user.userId\n        const res = await activityApi.getActivityByPublisher(publisherId)\n        if (res.code === 200) {\n          this.activityList = res.data || []\n          // 加载每个活动的统计数据\n          this.loadStatistics()\n        }\n      } catch (error) {\n        console.error('加载活动列表失败:', error)\n      } finally {\n        this.loading = false\n      }\n    },\n    async loadStatistics() {\n      for (const activity of this.activityList) {\n        try {\n          const [regRes, signRes] = await Promise.all([\n            registrationApi.getRegistrationCount(activity.activityId),\n            signScoreApi.getSignCount(activity.activityId)\n          ])\n          if (regRes.code === 200) {\n            this.$set(this.registrationCountMap, activity.activityId, regRes.data)\n          }\n          if (signRes.code === 200) {\n            this.$set(this.signCountMap, activity.activityId, signRes.data)\n          }\n        } catch (error) {\n          console.error('加载统计数据失败:', error)\n        }\n      }\n    },\n    getRegistrationCount(activityId) {\n      return this.registrationCountMap[activityId] || 0\n    },\n    getSignCount(activityId) {\n      return this.signCountMap[activityId] || 0\n    },\n    handleViewDetail(row) {\n      // 查看活动详情\n      this.$router.push(`/activity/${row.activityId}`)\n    },\n    formatDateTime(dateStr) {\n      if (!dateStr) return ''\n      const date = new Date(dateStr)\n      return date.toLocaleString('zh-CN')\n    }\n  }\n}\n</script>\n\n<style scoped>\n.activity-statistics {\n  padding: 20px;\n}\n</style>\n"],"mappings":"AAqCA,SAAAA,WAAA,EAAAC,eAAA,EAAAC,YAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,YAAA;MACAC,oBAAA;MACAC,YAAA;MACAC,OAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,gBAAA;EACA;EACAC,OAAA;IACA,MAAAD,iBAAA;MACA,KAAAF,OAAA;MACA;QACA,MAAAI,WAAA,QAAAC,MAAA,CAAAC,KAAA,CAAAC,IAAA,CAAAC,MAAA;QACA,MAAAC,GAAA,SAAAjB,WAAA,CAAAkB,sBAAA,CAAAN,WAAA;QACA,IAAAK,GAAA,CAAAE,IAAA;UACA,KAAAd,YAAA,GAAAY,GAAA,CAAAb,IAAA;UACA;UACA,KAAAgB,cAAA;QACA;MACA,SAAAC,KAAA;QACAC,OAAA,CAAAD,KAAA,cAAAA,KAAA;MACA;QACA,KAAAb,OAAA;MACA;IACA;IACA,MAAAY,eAAA;MACA,WAAAG,QAAA,SAAAlB,YAAA;QACA;UACA,OAAAmB,MAAA,EAAAC,OAAA,UAAAC,OAAA,CAAAC,GAAA,EACA1B,eAAA,CAAA2B,oBAAA,CAAAL,QAAA,CAAAM,UAAA,GACA3B,YAAA,CAAA4B,YAAA,CAAAP,QAAA,CAAAM,UAAA,EACA;UACA,IAAAL,MAAA,CAAAL,IAAA;YACA,KAAAY,IAAA,MAAAzB,oBAAA,EAAAiB,QAAA,CAAAM,UAAA,EAAAL,MAAA,CAAApB,IAAA;UACA;UACA,IAAAqB,OAAA,CAAAN,IAAA;YACA,KAAAY,IAAA,MAAAxB,YAAA,EAAAgB,QAAA,CAAAM,UAAA,EAAAJ,OAAA,CAAArB,IAAA;UACA;QACA,SAAAiB,KAAA;UACAC,OAAA,CAAAD,KAAA,cAAAA,KAAA;QACA;MACA;IACA;IACAO,qBAAAC,UAAA;MACA,YAAAvB,oBAAA,CAAAuB,UAAA;IACA;IACAC,aAAAD,UAAA;MACA,YAAAtB,YAAA,CAAAsB,UAAA;IACA;IACAG,iBAAAC,GAAA;MACA;MACA,KAAAC,OAAA,CAAAC,IAAA,cAAAF,GAAA,CAAAJ,UAAA;IACA;IACAO,eAAAC,OAAA;MACA,KAAAA,OAAA;MACA,MAAAC,IAAA,OAAAC,IAAA,CAAAF,OAAA;MACA,OAAAC,IAAA,CAAAE,cAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}