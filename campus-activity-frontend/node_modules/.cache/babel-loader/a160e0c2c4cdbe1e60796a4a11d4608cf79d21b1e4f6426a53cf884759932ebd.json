{"ast":null,"code":"import { registrationApi } from '@/api';\nexport default {\n  name: 'MyRegistration',\n  data() {\n    return {\n      registrationList: [],\n      loading: false\n    };\n  },\n  mounted() {\n    this.loadRegistrationList();\n  },\n  methods: {\n    async loadRegistrationList() {\n      this.loading = true;\n      try {\n        const userId = this.$store.state.user.userId;\n        const res = await registrationApi.getRegistrationList(userId);\n        if (res.code === 200) {\n          this.registrationList = res.data || [];\n        }\n      } catch (error) {\n        console.error('加载报名列表失败:', error);\n      } finally {\n        this.loading = false;\n      }\n    },\n    handleCancel(row) {\n      this.$confirm('确定要取消报名吗?', '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(async () => {\n        try {\n          const res = await registrationApi.cancelRegistration(row.registerId);\n          if (res.code === 200) {\n            this.$message.success('取消报名成功');\n            this.loadRegistrationList();\n          }\n        } catch (error) {\n          console.error('取消报名失败:', error);\n        }\n      });\n    },\n    getStatusType(status) {\n      const statusMap = {\n        '通过': 'success',\n        '拒绝': 'danger',\n        '待审': 'warning'\n      };\n      return statusMap[status] || 'info';\n    },\n    formatDateTime(dateStr) {\n      if (!dateStr) return '';\n      const date = new Date(dateStr);\n      return date.toLocaleString('zh-CN');\n    }\n  }\n};","map":{"version":3,"names":["registrationApi","name","data","registrationList","loading","mounted","loadRegistrationList","methods","userId","$store","state","user","res","getRegistrationList","code","error","console","handleCancel","row","$confirm","confirmButtonText","cancelButtonText","type","then","cancelRegistration","registerId","$message","success","getStatusType","status","statusMap","formatDateTime","dateStr","date","Date","toLocaleString"],"sources":["src/views/student/MyRegistration.vue"],"sourcesContent":["<template>\r\n  <div class=\"my-registration\">\r\n    <el-card>\r\n      <div slot=\"header\">\r\n        <span>我的报名</span>\r\n      </div>\r\n      \r\n      <el-table :data=\"registrationList\" border style=\"width: 100%\" v-loading=\"loading\">\r\n        <el-table-column prop=\"activityName\" label=\"活动名称\" min-width=\"150\"></el-table-column>\r\n        <el-table-column prop=\"registerTime\" label=\"报名时间\" width=\"180\">\r\n          <template slot-scope=\"scope\">\r\n            {{ formatDateTime(scope.row.registerTime) }}\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column prop=\"auditStatus\" label=\"审核状态\" width=\"120\">\r\n          <template slot-scope=\"scope\">\r\n            <el-tag :type=\"getStatusType(scope.row.auditStatus)\">\r\n              {{ scope.row.auditStatus || '待审' }}\r\n            </el-tag>\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column label=\"操作\" width=\"150\">\r\n          <template slot-scope=\"scope\">\r\n            <el-button \r\n              size=\"mini\" \r\n              type=\"danger\" \r\n              v-if=\"scope.row.auditStatus === '待审' || !scope.row.auditStatus\"\r\n              @click=\"handleCancel(scope.row)\">取消报名</el-button>\r\n            <span v-else>-</span>\r\n          </template>\r\n        </el-table-column>\r\n      </el-table>\r\n    </el-card>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { registrationApi } from '@/api'\r\n\r\nexport default {\r\n  name: 'MyRegistration',\r\n  data() {\r\n    return {\r\n      registrationList: [],\r\n      loading: false\r\n    }\r\n  },\r\n  mounted() {\r\n    this.loadRegistrationList()\r\n  },\r\n  methods: {\r\n    async loadRegistrationList() {\r\n      this.loading = true\r\n      try {\r\n        const userId = this.$store.state.user.userId\r\n        const res = await registrationApi.getRegistrationList(userId)\r\n        if (res.code === 200) {\r\n          this.registrationList = res.data || []\r\n        }\r\n      } catch (error) {\r\n        console.error('加载报名列表失败:', error)\r\n      } finally {\r\n        this.loading = false\r\n      }\r\n    },\r\n    handleCancel(row) {\r\n      this.$confirm('确定要取消报名吗?', '提示', {\r\n        confirmButtonText: '确定',\r\n        cancelButtonText: '取消',\r\n        type: 'warning'\r\n      }).then(async () => {\r\n        try {\r\n          const res = await registrationApi.cancelRegistration(row.registerId)\r\n          if (res.code === 200) {\r\n            this.$message.success('取消报名成功')\r\n            this.loadRegistrationList()\r\n          }\r\n        } catch (error) {\r\n          console.error('取消报名失败:', error)\r\n        }\r\n      })\r\n    },\r\n    getStatusType(status) {\r\n      const statusMap = {\r\n        '通过': 'success',\r\n        '拒绝': 'danger',\r\n        '待审': 'warning'\r\n      }\r\n      return statusMap[status] || 'info'\r\n    },\r\n    formatDateTime(dateStr) {\r\n      if (!dateStr) return ''\r\n      const date = new Date(dateStr)\r\n      return date.toLocaleString('zh-CN')\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.my-registration {\r\n  padding: 20px;\r\n}\r\n</style>\r\n"],"mappings":"AAqCA,SAAAA,eAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,gBAAA;MACAC,OAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,oBAAA;EACA;EACAC,OAAA;IACA,MAAAD,qBAAA;MACA,KAAAF,OAAA;MACA;QACA,MAAAI,MAAA,QAAAC,MAAA,CAAAC,KAAA,CAAAC,IAAA,CAAAH,MAAA;QACA,MAAAI,GAAA,SAAAZ,eAAA,CAAAa,mBAAA,CAAAL,MAAA;QACA,IAAAI,GAAA,CAAAE,IAAA;UACA,KAAAX,gBAAA,GAAAS,GAAA,CAAAV,IAAA;QACA;MACA,SAAAa,KAAA;QACAC,OAAA,CAAAD,KAAA,cAAAA,KAAA;MACA;QACA,KAAAX,OAAA;MACA;IACA;IACAa,aAAAC,GAAA;MACA,KAAAC,QAAA;QACAC,iBAAA;QACAC,gBAAA;QACAC,IAAA;MACA,GAAAC,IAAA;QACA;UACA,MAAAX,GAAA,SAAAZ,eAAA,CAAAwB,kBAAA,CAAAN,GAAA,CAAAO,UAAA;UACA,IAAAb,GAAA,CAAAE,IAAA;YACA,KAAAY,QAAA,CAAAC,OAAA;YACA,KAAArB,oBAAA;UACA;QACA,SAAAS,KAAA;UACAC,OAAA,CAAAD,KAAA,YAAAA,KAAA;QACA;MACA;IACA;IACAa,cAAAC,MAAA;MACA,MAAAC,SAAA;QACA;QACA;QACA;MACA;MACA,OAAAA,SAAA,CAAAD,MAAA;IACA;IACAE,eAAAC,OAAA;MACA,KAAAA,OAAA;MACA,MAAAC,IAAA,OAAAC,IAAA,CAAAF,OAAA;MACA,OAAAC,IAAA,CAAAE,cAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}