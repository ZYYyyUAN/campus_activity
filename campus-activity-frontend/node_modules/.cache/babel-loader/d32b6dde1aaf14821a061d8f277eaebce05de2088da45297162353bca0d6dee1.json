{"ast":null,"code":"import { registrationApi } from '@/api';\nexport default {\n  name: 'MyRegistration',\n  data() {\n    return {\n      registrationList: [],\n      loading: false\n    };\n  },\n  mounted() {\n    this.loadRegistrationList();\n  },\n  methods: {\n    async loadRegistrationList() {\n      this.loading = true;\n      try {\n        const userId = this.$store.state.user.userId;\n        const res = await registrationApi.getRegistrationList(userId);\n        if (res.code === 200) {\n          this.registrationList = res.data || [];\n        }\n      } catch (error) {\n        console.error('加载报名列表失败:', error);\n      } finally {\n        this.loading = false;\n      }\n    },\n    handleCancel(row) {\n      this.$confirm('确定要取消报名吗?', '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(async () => {\n        try {\n          const res = await registrationApi.cancelRegistration(row.registerId);\n          if (res.code === 200) {\n            this.$message.success('取消报名成功');\n            this.loadRegistrationList();\n          }\n        } catch (error) {\n          console.error('取消报名失败:', error);\n        }\n      });\n    },\n    getStatusType(status) {\n      const statusMap = {\n        '通过': 'success',\n        '拒绝': 'danger',\n        '待审': 'warning'\n      };\n      return statusMap[status] || 'info';\n    },\n    formatDateTime(dateStr) {\n      if (!dateStr) return '';\n      const date = new Date(dateStr);\n      return date.toLocaleString('zh-CN');\n    }\n  }\n};","map":{"version":3,"names":["registrationApi","name","data","registrationList","loading","mounted","loadRegistrationList","methods","userId","$store","state","user","res","getRegistrationList","code","error","console","handleCancel","row","$confirm","confirmButtonText","cancelButtonText","type","then","cancelRegistration","registerId","$message","success","getStatusType","status","statusMap","formatDateTime","dateStr","date","Date","toLocaleString"],"sources":["src/views/student/MyRegistration.vue"],"sourcesContent":["<template>\n  <div class=\"my-registration\">\n    <el-card>\n      <div slot=\"header\">\n        <span>我的报名</span>\n      </div>\n      \n      <el-table :data=\"registrationList\" border style=\"width: 100%\" v-loading=\"loading\">\n        <el-table-column prop=\"activityName\" label=\"活动名称\" min-width=\"150\"></el-table-column>\n        <el-table-column prop=\"activityType\" label=\"活动类型\" width=\"100\"></el-table-column>\n        <el-table-column prop=\"location\" label=\"活动地点\" width=\"120\"></el-table-column>\n        <el-table-column prop=\"startTime\" label=\"开始时间\" width=\"180\">\n          <template slot-scope=\"scope\">\n            {{ formatDateTime(scope.row.startTime) }}\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"registerTime\" label=\"报名时间\" width=\"180\">\n          <template slot-scope=\"scope\">\n            {{ formatDateTime(scope.row.registerTime) }}\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"auditStatus\" label=\"审核状态\" width=\"100\">\n          <template slot-scope=\"scope\">\n            <el-tag :type=\"getStatusType(scope.row.auditStatus)\">\n              {{ scope.row.auditStatus || '待审' }}\n            </el-tag>\n          </template>\n        </el-table-column>\n        <el-table-column label=\"签到状态\" width=\"100\">\n          <template slot-scope=\"scope\">\n            <el-tag :type=\"scope.row.hasSigned ? 'success' : 'info'\">\n              {{ scope.row.hasSigned ? '已签到' : '未签到' }}\n            </el-tag>\n          </template>\n        </el-table-column>\n        <el-table-column label=\"操作\" width=\"260\" fixed=\"right\">\n          <template slot-scope=\"scope\">\n            <!-- 待审状态：可以取消报名 -->\n            <el-button \n              v-if=\"scope.row.auditStatus === '待审' || !scope.row.auditStatus\"\n              size=\"mini\" \n              type=\"danger\"\n              @click=\"handleCancel(scope.row)\">取消报名</el-button>\n            \n            <!-- 审核通过且未签到：显示签到按钮 -->\n            <el-button \n              v-if=\"scope.row.auditStatus === '通过' && !scope.row.hasSigned\"\n              size=\"mini\" \n              type=\"primary\"\n              @click=\"handleSign(scope.row)\">签到</el-button>\n            \n            <!-- 已签到且未评价：显示评价按钮 -->\n            <el-button \n              v-if=\"scope.row.hasSigned && !scope.row.hasEvaluated\"\n              size=\"mini\" \n              type=\"success\"\n              @click=\"handleEvaluate(scope.row)\">评价活动</el-button>\n            \n            <!-- 已评价：显示标签 -->\n            <el-tag v-if=\"scope.row.hasEvaluated\" type=\"success\" size=\"small\">已评价</el-tag>\n            \n            <!-- 审核拒绝：显示原因（如果有） -->\n            <span v-if=\"scope.row.auditStatus === '拒绝'\" style=\"color: #909399; font-size: 12px;\">\n              已拒绝\n            </span>\n          </template>\n        </el-table-column>\n      </el-table>\n    </el-card>\n  </div>\n</template>\n\n<script>\nimport { registrationApi } from '@/api'\n\nexport default {\n  name: 'MyRegistration',\n  data() {\n    return {\n      registrationList: [],\n      loading: false\n    }\n  },\n  mounted() {\n    this.loadRegistrationList()\n  },\n  methods: {\n    async loadRegistrationList() {\n      this.loading = true\n      try {\n        const userId = this.$store.state.user.userId\n        const res = await registrationApi.getRegistrationList(userId)\n        if (res.code === 200) {\n          this.registrationList = res.data || []\n        }\n      } catch (error) {\n        console.error('加载报名列表失败:', error)\n      } finally {\n        this.loading = false\n      }\n    },\n    handleCancel(row) {\n      this.$confirm('确定要取消报名吗?', '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(async () => {\n        try {\n          const res = await registrationApi.cancelRegistration(row.registerId)\n          if (res.code === 200) {\n            this.$message.success('取消报名成功')\n            this.loadRegistrationList()\n          }\n        } catch (error) {\n          console.error('取消报名失败:', error)\n        }\n      })\n    },\n    getStatusType(status) {\n      const statusMap = {\n        '通过': 'success',\n        '拒绝': 'danger',\n        '待审': 'warning'\n      }\n      return statusMap[status] || 'info'\n    },\n    formatDateTime(dateStr) {\n      if (!dateStr) return ''\n      const date = new Date(dateStr)\n      return date.toLocaleString('zh-CN')\n    }\n  }\n}\n</script>\n\n<style scoped>\n.my-registration {\n  padding: 20px;\n}\n</style>\n"],"mappings":"AAyEA,SAAAA,eAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,gBAAA;MACAC,OAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,oBAAA;EACA;EACAC,OAAA;IACA,MAAAD,qBAAA;MACA,KAAAF,OAAA;MACA;QACA,MAAAI,MAAA,QAAAC,MAAA,CAAAC,KAAA,CAAAC,IAAA,CAAAH,MAAA;QACA,MAAAI,GAAA,SAAAZ,eAAA,CAAAa,mBAAA,CAAAL,MAAA;QACA,IAAAI,GAAA,CAAAE,IAAA;UACA,KAAAX,gBAAA,GAAAS,GAAA,CAAAV,IAAA;QACA;MACA,SAAAa,KAAA;QACAC,OAAA,CAAAD,KAAA,cAAAA,KAAA;MACA;QACA,KAAAX,OAAA;MACA;IACA;IACAa,aAAAC,GAAA;MACA,KAAAC,QAAA;QACAC,iBAAA;QACAC,gBAAA;QACAC,IAAA;MACA,GAAAC,IAAA;QACA;UACA,MAAAX,GAAA,SAAAZ,eAAA,CAAAwB,kBAAA,CAAAN,GAAA,CAAAO,UAAA;UACA,IAAAb,GAAA,CAAAE,IAAA;YACA,KAAAY,QAAA,CAAAC,OAAA;YACA,KAAArB,oBAAA;UACA;QACA,SAAAS,KAAA;UACAC,OAAA,CAAAD,KAAA,YAAAA,KAAA;QACA;MACA;IACA;IACAa,cAAAC,MAAA;MACA,MAAAC,SAAA;QACA;QACA;QACA;MACA;MACA,OAAAA,SAAA,CAAAD,MAAA;IACA;IACAE,eAAAC,OAAA;MACA,KAAAA,OAAA;MACA,MAAAC,IAAA,OAAAC,IAAA,CAAAF,OAAA;MACA,OAAAC,IAAA,CAAAE,cAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}